// ---------------------------------------------------------------- POSIX TZ rule handling
//
// POSIX form: stdoffset[dst[offset][,start[/time],end[/time]]]
// Offsets are the value added to local time to get UTC, so North America is positive.
// A name is three or more letters or a quoted form such as <+0530> or <-03>.
// DST mode 1 strips the daylight half (standard time all year, DST off); mode 2 keeps the
// daylight offset all year (DST permanently on).

namespace tzrule {

struct Parts {
  char stdName[16];
  char dstName[16];
  long stdOffset;     // seconds
  long dstOffset;     // seconds
  bool hasDst;
};

const char* parseName(const char* s, char* out, size_t n) {
  size_t len = 0;
  if (*s == '<') {
    ++s;
    while (*s && *s != '>') {
      const char c = *s;
      const bool ok = (c >= '0' && c <= '9') || (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '+' || c == '-';
      if (!ok || len + 1 >= n) return nullptr;
      out[len++] = *s++;
    }
    if (*s != '>') return nullptr;
    ++s;
  } else {
    while ((*s >= 'A' && *s <= 'Z') || (*s >= 'a' && *s <= 'z')) {
      if (len + 1 >= n) return nullptr;
      out[len++] = *s++;
    }
    if (len < 3) return nullptr;                    // POSIX: unquoted names are 3+ letters
  }
  if (len < 1) return nullptr;
  out[len] = '\0';
  return s;
}

// Offsets: [+|-]hh[:mm[:ss]]. Zone offsets allow 24 hours; transition times allow 167.
const char* parseOffset(const char* s, long& secs, bool& present, long maxHours = 24) {
  present = false;
  int sign = 1;
  if (*s == '+') { ++s; }
  else if (*s == '-') { sign = -1; ++s; }
  if (*s < '0' || *s > '9') return s;
  long v[3] = { 0, 0, 0 };
  for (int field = 0; field < 3; ++field) {
    long acc = 0;
    int digits = 0;
    while (*s >= '0' && *s <= '9' && digits < 3) { acc = acc * 10 + (*s++ - '0'); ++digits; }
    if (digits == 0) return nullptr;
    v[field] = acc;
    if (*s != ':') break;
    ++s;
  }
  if (v[0] > maxHours || v[1] > 59 || v[2] > 59) return nullptr;
  secs = sign * (v[0] * 3600 + v[1] * 60 + v[2]);
  present = true;
  return s;
}

// Transition rule: Jn | n | Mm.w.d, optional /time.
const char* parseDate(const char* s) {
  long a = 0;
  auto num = [&](long lo, long hi) -> bool {
    int digits = 0;
    a = 0;
    while (*s >= '0' && *s <= '9' && digits < 3) { a = a * 10 + (*s++ - '0'); ++digits; }
    return digits > 0 && a >= lo && a <= hi;
  };
  if (*s == 'M') {
    ++s;
    if (!num(1, 12) || *s++ != '.') return nullptr;
    if (!num(1, 5) || *s++ != '.') return nullptr;
    if (!num(0, 6)) return nullptr;
  } else if (*s == 'J') {
    ++s;
    if (!num(1, 365)) return nullptr;
  } else {
    if (!num(0, 365)) return nullptr;
  }
  if (*s == '/') {
    ++s;
    long t = 0;
    bool present = false;
    s = parseOffset(s, t, present, 167);
    if (!s || !present) return nullptr;
  }
  return s;
}

bool parse(const char* tz, Parts& p) {
  if (!tz || !*tz) return false;
  std::memset(&p, 0, sizeof p);
  const char* s = parseName(tz, p.stdName, sizeof p.stdName);
  if (!s) return false;
  bool present = false;
  s = parseOffset(s, p.stdOffset, present);
  if (!s || !present) return false;
  if (*s == '\0') return true;                      // no daylight half
  s = parseName(s, p.dstName, sizeof p.dstName);
  if (!s) return false;
  p.hasDst = true;
  p.dstOffset = p.stdOffset - 3600;                 // POSIX default: one hour ahead
  s = parseOffset(s, p.dstOffset, present);
  if (!s) return false;
  if (*s == '\0') return true;                      // newlib then applies its default rule
  if (*s++ != ',') return false;
  s = parseDate(s);
  if (!s || *s++ != ',') return false;
  s = parseDate(s);
  return s && *s == '\0';
}

void formatOffset(long secs, char* out, size_t n) {
  const long a = secs < 0 ? -secs : secs;
  const int h = (int)(a / 3600), m = (int)((a % 3600) / 60), sec = (int)(a % 60);
  const char* sign = secs < 0 ? "-" : "";
  if (sec) std::snprintf(out, n, "%s%d:%02d:%02d", sign, h, m, sec);
  else if (m) std::snprintf(out, n, "%s%d:%02d", sign, h, m);
  else std::snprintf(out, n, "%s%d", sign, h);
}

void formatName(const char* name, char* out, size_t n) {
  bool plain = std::strlen(name) >= 3;
  for (const char* c = name; *c && plain; ++c)
    if (!((*c >= 'A' && *c <= 'Z') || (*c >= 'a' && *c <= 'z'))) plain = false;
  if (plain) std::snprintf(out, n, "%s", name);
  else std::snprintf(out, n, "<%s>", name);
}

// mode 0 = rule unchanged, 1 = standard offset all year, 2 = daylight offset all year.
// Returns false and copies the input unchanged when the rule cannot be parsed.
bool applyMode(const char* tz, uint8_t mode, char* out, size_t n) {
  if (n == 0) return false;
  util::copyStr(out, n, tz);
  if (mode == 0) return true;
  Parts p;
  if (!parse(tz, p)) return false;
  const bool wantDst = (mode == 2) && p.hasDst;
  char name[20], off[16];
  formatName(wantDst ? p.dstName : p.stdName, name, sizeof name);
  formatOffset(wantDst ? p.dstOffset : p.stdOffset, off, sizeof off);
  std::snprintf(out, n, "%s%s", name, off);
  return true;
}

// POSIX TZ character set, 3..63 characters, and it must parse as a rule.
bool valid(const char* tz) {
  const size_t n = std::strlen(tz);
  if (n < 3 || n > 63) return false;
  for (size_t i = 0; i < n; ++i) {
    const char c = tz[i];
    const bool ok = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
                    c == '<' || c == '>' || c == '+' || c == '-' || c == ':' || c == ',' || c == '.' || c == '/';
    if (!ok) return false;
  }
  Parts p;
  return parse(tz, p);
}

}  // namespace tzrule

