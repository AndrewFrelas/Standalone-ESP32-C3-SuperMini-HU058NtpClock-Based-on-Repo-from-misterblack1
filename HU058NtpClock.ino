// ============================================================================ PURE LOGIC

namespace util {

void copyStr(char* dst, size_t n, const char* src) {
  if (n == 0) return;
  std::strncpy(dst, src ? src : "", n - 1);
  dst[n - 1] = '\0';
}

int hexNibble(char c) {
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return -1;
}

// "RRGGBB" or "#RRGGBB" -> rgb. False on anything else.
bool parseHex(const char* s, uint8_t out[3]) {
  if (!s) return false;
  if (*s == '#') ++s;
  if (std::strlen(s) != 6) return false;
  for (int i = 0; i < 3; ++i) {
    const int hi = hexNibble(s[i * 2]), lo = hexNibble(s[i * 2 + 1]);
    if (hi < 0 || lo < 0) return false;
    out[i] = (uint8_t)(hi * 16 + lo);
  }
  return true;
}

void toHex(const uint8_t rgb[3], char out[8]) {
  std::snprintf(out, 8, "#%02x%02x%02x", rgb[0], rgb[1], rgb[2]);
}

// Strict integer parse: optional sign, digits only, whole string, inside [lo, hi].
bool parseLong(const char* s, long lo, long hi, long& out) {
  if (!s || !*s) return false;
  char* end = nullptr;
  const long v = std::strtol(s, &end, 10);
  if (!end || *end != '\0') return false;
  if (v < lo || v > hi) return false;
  out = v;
  return true;
}

// Strict decimal parse into an integer scaled by `scale` (10 = tenths, 100 = hundredths).
bool parseScaled(const char* s, long scale, long lo, long hi, long& out) {
  if (!s || !*s) return false;
  char* end = nullptr;
  const double v = std::strtod(s, &end);
  if (!end || *end != '\0' || !std::isfinite(v)) return false;
  const long scaled = (long)std::lround(v * (double)scale);
  if (scaled < lo || scaled > hi) return false;
  out = scaled;
  return true;
}

bool parseBool(const char* s, bool& out) {
  if (!s) return false;
  if (!std::strcmp(s, "1") || !std::strcmp(s, "true") || !std::strcmp(s, "on")) { out = true; return true; }
  if (!std::strcmp(s, "0") || !std::strcmp(s, "false") || !std::strcmp(s, "off")) { out = false; return true; }
  return false;
}

// Printable ASCII only, for text echoed into JSON or shown on the face.
bool printable(const char* s) {
  for (; *s; ++s) if ((unsigned char)*s < 0x20 || (unsigned char)*s > 0x7E) return false;
  return true;
}

