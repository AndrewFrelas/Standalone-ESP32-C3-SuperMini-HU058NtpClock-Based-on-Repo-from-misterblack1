// HU058NtpClock - Ractl Designs
// NTP clock firmware for the HU-058 / HU-058SE "IoT Colorful" clock kit (STC8G1K17 + DS1302
// board), with an ESP32-C3 SuperMini in place of the STC8G1K17 driving both AiP33628 matrix
// drivers directly. Time, time zone, daylight saving, colours, effects and settings run on the
// SuperMini and are controlled from its own web page. No external libraries.
//
// Timekeeping, Wi-Fi, settings storage and the web plumbing follow NtpClockMod (the 4-in-1
// clock mod on the same SuperMini). Panel protocol and LED map: misterblack1,
// https://github.com/misterblack1/HU-058_ESPHome (docs/display-map.md, docs/aip33628-protocol.md)
//
// Target : ESP32-C3 SuperMini, Arduino IDE 2.x, Espressif "esp32" core 3.3.x
// Board  : Tools > Board > esp32 > "Nologo ESP32C3 Super Mini"
//          Tools > USB CDC On Boot: Enabled        (serial log over the C3's native USB)
//          Tools > Partition Scheme: "Default 4MB with spiffs (1.2MB APP/1.5MB SPIFFS)"
//          Not "Huge APP" or any "No OTA" scheme: those remove firmware updates over Wi-Fi.
// Web UI : http://hu058clock.local/
//
// Wiring (SuperMini -> clock board MCU footprint, DIP-16). Fit SW1, SW2, USB1, C3, C4 only.
//   GPIO4  -> DIP pin 16   CLK,    driver 1 (pin 14 is the DS1302 RST line on this board)
//   GPIO5  -> DIP pin 5    DATA,   driver 1
//   GPIO6  -> DIP pin 1    CLK_1,  driver 2
//   GPIO7  -> DIP pin 2    DATA_1, driver 2
//   GPIO3  -> DIP pin 9    S1, top button (SW2 on the board)
//   GPIO10 -> DIP pin 10   S2, bottom button (SW1 on the board)
//   5V     -> DIP pin 6    +5V (VCC)
//   GND    -> DIP pin 8
//   Never power from the clock's USB and the SuperMini's USB-C at the same time.
//
// Buttons: S1 tap = brightness step, S1 hold = display on/off, S2 tap = next effect,
//          S2 hold = show IP address, both held 10 s = factory reset (Wi-Fi is kept).

// ============================================================================ CONFIGURATION

#define FW_VERSION              "01.02.02"

// ---- Wi-Fi and name
// Real Wi-Fi details here are used, and remembered once the clock has joined with them. Left as
// the placeholders, the clock keeps the network it last joined, so a .bin built from this file
// as published can be uploaded to any working clock without losing its network.
#define WIFI_SSID               "your-ssid"
#define WIFI_PASSWORD           "your-password"
// First-boot default only. After that the name is set on the Network tab and kept through
// firmware updates; a factory reset returns to this.
#define DEVICE_HOSTNAME         "hu058clock"        // web UI: http://hu058clock.local/

// Reconnect policy: the device retries for as long as it is powered, forever.
#define WIFI_RETRY_MIN_MS       5000UL              // first retry delay after a drop
#define WIFI_RETRY_MAX_MS       60000UL             // retry delay ceiling
#define WIFI_RADIO_RESET_TRIES  12                  // failed tries before the radio is restarted

// Transmit power. Every converging report on the C3 SuperMini running hot points at the radio,
// not the core: a no-WiFi build stays cool, cutting TX power fixed it outright for one user,
// and a thermal camera showed 60 C -> 40 C from allowing modem sleep.
// esp_wifi_set_max_tx_power takes 0.25 dBm units, range [8, 84] = 2 to 20 dBm, and QUANTISES
// to 2, 5, 7, 8, 11, 13, 14, 15, 16, 18, 20 dBm; anything between rounds DOWN.
// Must be re-applied after every STA start - a radio reset puts it back to the default.
#define WIFI_TX_DBM_DEFAULT     11

// Modem sleep: 0 = none, 1 = min modem, 2 = max modem. Off by default: it slows the web page.
#define WIFI_PS_MODE_DEFAULT    0

// ---- Optional web UI login. Empty user = no authentication (LAN only).
#define WEB_AUTH_USER           ""
#define WEB_AUTH_PASS           ""

// ---- Arduino IDE network upload (ArduinoOTA). Empty = no password.
#define OTA_PASSWORD            ""

// ---- Time defaults (first boot only; all editable in the web UI)
// lwIP is given exactly ONE server at a time; the failover policy lives in ntpPolicy().
#define DEFAULT_NTP_SERVER      "time.chu.nrc.ca"
#define DEFAULT_NTP_SERVER2     "time.nrc.ca"       // empty string = slot unused
#define DEFAULT_NTP_SERVER3     ""
#define NTP_SERVER_SLOTS        3

// Failover policy. A server that has not answered within NTP_PROBE_S of being selected is passed
// over. One that has answered is judged on ongoing silence over NTP_FAILOVER_AFTER_MULT poll
// intervals floored at NTP_FAILOVER_MIN_S. While on a fallback the primary is retried every
// NTP_RETURN_PRIMARY_S and keeps the slot if it answers.
#define NTP_FAILOVER_DEFAULT    true
#define NTP_FAILOVER_AFTER_MULT 2
#define NTP_FAILOVER_MIN_S      90UL
#define NTP_RETURN_PRIMARY_S    1800UL
#define NTP_PROBE_S             60UL

// How often ntpPolicy() does real work. Anything called from loop() must not take a lock on its
// common path; the policy bails on a plain millis() comparison first.
#define NTP_POLICY_PERIOD_MS    1000UL
#define DEFAULT_TZ              "EST5EDT,M3.2.0,M11.1.0"   // POSIX rule, America/Toronto
#define DEFAULT_SYNC_INTERVAL_S 60                  // NTP poll interval, seconds
#define DEFAULT_DST_MODE        0                   // 0 = follow zone rule, 1 = standard only, 2 = daylight only

// Crystal drift: two-point estimate, NTP time elapsed against esp_timer elapsed from a baseline
// taken at the first sync. Noise floor is 2 * jitter / span; quoted once the span is long enough.
#define DRIFT_PPM_LIMIT         250.0f    // discard any estimate outside +/- this: bad data
#define DRIFT_VALID_SPAN_S      3600UL    // baseline before the figure is trusted
#define DRIFT_SYNC_JITTER_US    10000.0f  // assumed per-endpoint sync jitter, for the error bar
#define DRIFT_RECENT_MIN_SPAN_S 1800UL    // shortest window for the recent-rate diagnostic

#define NTP_MIN_INTERVAL_S      15UL      // RFC 4330 floor
#define NTP_MAX_INTERVAL_S      86400UL

// Sync health for the optional colon status dot: link up and a sync within this many poll
// intervals, floored at NTP_HEALTH_MIN_S.
#define NTP_HEALTH_MULT         3UL
#define NTP_HEALTH_MIN_S        3600UL

// ---- Wiring: ESP32-C3 SuperMini GPIO -> HU-058 MCU footprint (DIP-16) pin
// All four display lines must be GPIO0..21 (single output register on the C3). Avoid GPIO2, 8 and
// 9 (strapping; GPIO8 is also the SuperMini's blue LED, GPIO9 its BOOT button) and GPIO18/19
// (native USB). GPIO20/21 are UART0, which the ROM bootloader talks on at reset.
#define PIN_CLK                 4   // DIP pin 16, driver 1 clock
#define PIN_DATA                5   // DIP pin 5,  driver 1 data
#define PIN_CLK_1               6   // DIP pin 1,  driver 2 clock
#define PIN_DATA_1              7   // DIP pin 2,  driver 2 data
#define PIN_BTN_1               3   // DIP pin 9,  S1, top button, SW2 on the board (switch to GND)
#define PIN_BTN_2               10  // DIP pin 10, S2, bottom button, SW1 on the board (switch to GND)

// ---- Display defaults (first boot only)
#define DEFAULT_LIGHT_ON        true
#define DEFAULT_BRIGHTNESS      50                  // percent, 1..100
#define DEFAULT_COLOR_R         255
#define DEFAULT_COLOR_G         255
#define DEFAULT_COLOR_B         255
#define DEFAULT_TWELVE_HOUR     true                // true = 12 hour, false = 24 hour
#define DEFAULT_BLINK_COLON     true
#define DEFAULT_LEADING_ZERO    false
#define DEFAULT_COLON_STATUS    false               // true = upper colon dot shows sync health

// Ceiling on the driver current step IS[3:0], 0..15 (2.5 mA .. 40.4 mA per lit sink). Fixed and
// never derived from what is on screen. The board is labelled 250 mA; a lit white digit at 15
// draws about 400 mA and full white about 1.2 A. Lower it if the drivers run hotter than you want.
#define DEFAULT_MAX_CURRENT     12
#define LAMP_TEST_BRIGHTNESS    50                  // percent, still capped by max current

// ---- Buttons
#define BTN_DEBOUNCE_MS         25UL
#define BTN_LONG_MS             1000UL
#define BTN_COMBO_SHOW_MS       2000UL              // both held this long: reset countdown shows
#define BTN_FACTORY_RESET_MS    10000UL             // both held this long: factory reset
#define BTN_FEEDBACK_MS         1200UL
#define BRIGHTNESS_STEPS_LIST   5, 15, 30, 50, 75, 100   // S1 short press cycles these (percent)

// ---- Timing
#define SETTINGS_SAVE_DELAY_MS  5000UL              // display settings: NVS write this long after the last change
#define DISPLAY_PERIOD_MS       100UL               // face housekeeping cadence; the time itself redraws on the second
#define EFFECT_PERIOD_MS        40UL                // effect animation cadence, 25 Hz
#define TEMP_MODE_MIN_MS        100UL
#define TEMP_MODE_MAX_MS        600000UL

// ---- Display bus
// The AiP33628 needs 16 ns of CLK high and low. These NOPs pad every edge to about 50 ns at
// 160 MHz on top of the GPIO store itself, a 3x margin with 3.3 V drive into a 5 V part.
#define BUS_EDGE_NOPS           8

