  char     ntpServer2[64];    // empty = slot unused
  char     ntpServer3[64];
  char     hostname[33];      // mDNS / DHCP name, 1..32 of [a-z0-9-]
  bool     ntpFailover;       // false = slot 0 only, never try another server
  char     tz[64];            // POSIX rule as chosen in the UI, before the DST mode is applied
  uint32_t syncIntervalS;
  uint8_t  dstMode;
  int8_t   wifiTxDbm;         // 2..20, quantised by the radio to the steps above
  uint8_t  wifiPsMode;        // 0 none, 1 min modem, 2 max modem
  // ---- display
  uint8_t  lightOn;
  uint8_t  brightness;        // 1..100 percent
  uint8_t  maxCurrent;        // 0..15
  uint8_t  rgb[3];            // solid colour
  uint8_t  twelveHour;
  uint8_t  blinkColon;
  uint8_t  leadingZero;
  uint8_t  colonStatus;       // 1 = upper colon dot shows sync health
  uint8_t  colorMode;         // CM_*
  uint8_t  digitRgb[4][3];
  uint8_t  gradA[3];
  uint8_t  gradB[3];
  int16_t  gradAngle;         // -180..180 degrees
  uint8_t  ledRgb[33][3];     // index = board id - 1
  uint8_t  effect;            // FX_*
  uint8_t  spread;            // SP_*
  int16_t  effectAngle;       // -180..180 degrees
  uint16_t hueSpan;           // 0..360 degrees
  uint16_t effectSpeedDs;     // seconds x10, 2..6000
  uint16_t flashFadeCs;       // seconds x100, 0..3000
  uint16_t dateEveryS;        // 0 = off, else 10..3600
  uint16_t dateShowMs;        // 500..10000
  uint8_t  dateFormat;        // 0 = MM-DD, 1 = DD-MM
  uint8_t  nightEnabled;
  uint16_t nightStartMin;     // 0..1439
  uint16_t nightEndMin;       // 0..1439
  uint8_t  nightBrightness;   // 0 = display off at night, else 1..100
};

// The transmit powers the radio can actually produce, in dBm. Anything else rounds down.
const int8_t WIFI_TX_STEPS[] = { 2, 5, 7, 8, 11, 13, 14, 15, 16, 18, 20 };
const uint8_t WIFI_TX_STEPS_N = sizeof WIFI_TX_STEPS / sizeof WIFI_TX_STEPS[0];

Settings g_settings;
uint32_t g_bootCount = 0;
esp_reset_reason_t g_resetReason = ESP_RST_UNKNOWN;

// Forward declarations: settings writes pause the display scan around flash.
namespace panel { void pauseForFlash(); void resumeAfterFlash(); }

namespace settings {

namespace impl {

const char* const NVS_NS = "hu058";

bool isAlnum(char c) {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
}

bool dirty_ = false;
uint32_t dirtySinceMs_ = 0;
bool hostStored_ = false;                          // the name is in NVS, not just the default
bool lastSaveOk_ = true;

}  // namespace impl

// Hostname or IPv4 literal, 1..63 characters.
bool validNtpServer(const char* s) {
  const size_t n = std::strlen(s);
  if (n == 0 || n > 63) return false;
  char prev = '.';                                   // forbids a leading '.' or '-'
  for (size_t i = 0; i < n; ++i) {
    const char c = s[i];
    if (c == '.') {
      if (prev == '.' || prev == '-') return false;   // empty label or label ending in '-'
    } else if (c == '-') {
      if (prev == '.') return false;                  // label starting with '-'
    } else if (!impl::isAlnum(c)) {
      return false;
    }
    prev = c;
  }
  return prev != '.' && prev != '-';
}

// Snap a requested transmit power to a step the radio can actually produce, never upward.
int8_t quantiseTxDbm(int v) {
  if (v <= WIFI_TX_STEPS[0]) return WIFI_TX_STEPS[0];
  for (uint8_t i = WIFI_TX_STEPS_N; i-- > 0; )
    if (v >= WIFI_TX_STEPS[i]) return WIFI_TX_STEPS[i];
  return WIFI_TX_STEPS[0];
}

bool validTz(const char* s) { return tzrule::valid(s); }

// RFC 1123 host label, lower case: 1..32 of [a-z0-9-], not starting or ending with '-'.
bool validHostname(const char* s) {
  const size_t n = std::strlen(s);
  if (n < 1 || n > 32 || s[0] == '-' || s[n - 1] == '-') return false;
  for (size_t i = 0; i < n; ++i) {
    const char c = s[i];
    if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')) return false;
  }
  return true;
}

uint32_t clampInterval(uint32_t s) {
  if (s < NTP_MIN_INTERVAL_S) return NTP_MIN_INTERVAL_S;
  if (s > NTP_MAX_INTERVAL_S) return NTP_MAX_INTERVAL_S;
  return s;
}

// Effective POSIX rule: the stored zone rule with the DST mode applied.
void effectiveTz(char* out, size_t n) {
  tzrule::applyMode(g_settings.tz, g_settings.dstMode, out, n);
}

void defaults() {
  Settings& s = g_settings;
  std::memset(&s, 0, sizeof s);
  util::copyStr(s.ntpServer, sizeof s.ntpServer, DEFAULT_NTP_SERVER);
  util::copyStr(s.ntpServer2, sizeof s.ntpServer2, DEFAULT_NTP_SERVER2);
  util::copyStr(s.ntpServer3, sizeof s.ntpServer3, DEFAULT_NTP_SERVER3);
  util::copyStr(s.hostname, sizeof s.hostname, validHostname(DEVICE_HOSTNAME) ? DEVICE_HOSTNAME : "hu058clock");
  s.ntpFailover = NTP_FAILOVER_DEFAULT;
  util::copyStr(s.tz, sizeof s.tz, DEFAULT_TZ);
  s.syncIntervalS = DEFAULT_SYNC_INTERVAL_S;
  s.dstMode = DEFAULT_DST_MODE;
  s.wifiTxDbm = WIFI_TX_DBM_DEFAULT;
  s.wifiPsMode = WIFI_PS_MODE_DEFAULT;
  s.lightOn = DEFAULT_LIGHT_ON;
  s.brightness = DEFAULT_BRIGHTNESS;
  s.maxCurrent = DEFAULT_MAX_CURRENT;
  s.rgb[0] = DEFAULT_COLOR_R; s.rgb[1] = DEFAULT_COLOR_G; s.rgb[2] = DEFAULT_COLOR_B;
  s.twelveHour = DEFAULT_TWELVE_HOUR;
  s.blinkColon = DEFAULT_BLINK_COLON;
  s.leadingZero = DEFAULT_LEADING_ZERO;
  s.colonStatus = DEFAULT_COLON_STATUS;
  s.colorMode = CM_SOLID;
  const uint8_t demo[4][3] = { {255, 0, 0}, {255, 115, 0}, {0, 255, 64}, {26, 77, 255} };
  std::memcpy(s.digitRgb, demo, sizeof demo);
  s.gradA[0] = 0;   s.gradA[1] = 255; s.gradA[2] = 26;
  s.gradB[0] = 255; s.gradB[1] = 217; s.gradB[2] = 0;
  s.gradAngle = -45;
  for (uint8_t i = 0; i < 33; ++i) { s.ledRgb[i][0] = 255; s.ledRgb[i][1] = 255; s.ledRgb[i][2] = 255; }
  s.effect = FX_NONE;
  s.spread = SP_PANEL;
  s.effectAngle = 0;
  s.hueSpan = 90;
  s.effectSpeedDs = 100;
  s.flashFadeCs = 0;
  s.dateEveryS = 0;
  s.dateShowMs = 2000;
  s.dateFormat = 0;
  s.nightEnabled = 0;
  s.nightStartMin = 22 * 60;
  s.nightEndMin = 7 * 60;
  s.nightBrightness = 5;
}

// Firmware before 01.02.00 kept one settings record ("cfg") and a Wi-Fi reconnect hint ("hint")
// in "hu058clk". Not carried over: the layout differs. Cleared once so they stop occupying NVS.
void dropLegacy() {
  Preferences p;
  if (!p.begin("hu058clk", true)) return;          // absent: nothing to do, nothing created
  const bool stale = p.isKey("cfg") || p.isKey("hint");
  p.end();
  if (!stale) return;
  panel::pauseForFlash();
  if (p.begin("hu058clk", false)) { p.clear(); p.end(); }
  panel::resumeAfterFlash();
  Serial.println("Settings from firmware before 01.02.00 cleared; defaults in use");
}

// Every key is read with its own validation; anything missing or out of range keeps its default.
void load() {
  dropLegacy();
  defaults();
  Settings& s = g_settings;
  Preferences p;
  if (!p.begin(impl::NVS_NS, true)) return;        // nothing stored yet: defaults
  char buf[64];
  if (p.isKey("ntp") && p.getString("ntp", buf, sizeof buf) > 0 && validNtpServer(buf))
    util::copyStr(s.ntpServer, sizeof s.ntpServer, buf);
  // getString returns 0 WITHOUT writing to buf on a read error, so buf is cleared first: a
  // failure then reads as an empty fallback, never as the previous key's value.
  if (p.isKey("ntp2")) {
    buf[0] = '\0'; p.getString("ntp2", buf, sizeof buf);
    if (buf[0] == '\0' || validNtpServer(buf)) util::copyStr(s.ntpServer2, sizeof s.ntpServer2, buf);
  }
  if (p.isKey("ntp3")) {
    buf[0] = '\0'; p.getString("ntp3", buf, sizeof buf);
    if (buf[0] == '\0' || validNtpServer(buf)) util::copyStr(s.ntpServer3, sizeof s.ntpServer3, buf);
  }
  s.ntpFailover = p.getBool("ntpfo", NTP_FAILOVER_DEFAULT);
  if (p.isKey("host") && p.getString("host", buf, sizeof buf) > 0 && validHostname(buf)) {
    util::copyStr(s.hostname, sizeof s.hostname, buf);
    impl::hostStored_ = true;
  }
  if (p.isKey("tz") && p.getString("tz", buf, sizeof buf) > 0 && validTz(buf))
    util::copyStr(s.tz, sizeof s.tz, buf);
  s.syncIntervalS = clampInterval(p.getULong("ival", DEFAULT_SYNC_INTERVAL_S));
  const uint8_t dst = p.getUChar("dst", DEFAULT_DST_MODE);
  s.dstMode = dst <= DST_DAYLIGHT ? dst : (uint8_t)DST_AUTO;
  s.wifiTxDbm = quantiseTxDbm(p.getChar("wtx", WIFI_TX_DBM_DEFAULT));
  const uint8_t ps = p.getUChar("wps", WIFI_PS_MODE_DEFAULT);
  s.wifiPsMode = ps <= 2 ? ps : (uint8_t)0;

  auto u8 = [&](const char* k, uint8_t def, uint8_t lo, uint8_t hi) {
    const uint8_t v = p.getUChar(k, def);
    return (v < lo || v > hi) ? def : v;
  };
  auto u16 = [&](const char* k, uint16_t def, uint16_t lo, uint16_t hi) {
    const uint16_t v = p.getUShort(k, def);
    return (v < lo || v > hi) ? def : v;
  };
  auto i16 = [&](const char* k, int16_t def, int16_t lo, int16_t hi) {
    const int16_t v = p.getShort(k, def);
    return (v < lo || v > hi) ? def : v;
  };
  auto bytes = [&](const char* k, void* dst, size_t n) {
    if (p.getBytesLength(k) == n) p.getBytes(k, dst, n);
  };
  s.lightOn = u8("on", s.lightOn, 0, 1);
  s.brightness = u8("bri", s.brightness, 1, 100);
  s.maxCurrent = u8("maxi", s.maxCurrent, 0, 15);
  bytes("rgb", s.rgb, sizeof s.rgb);
  s.twelveHour = u8("h12", s.twelveHour, 0, 1);
  s.blinkColon = u8("blink", s.blinkColon, 0, 1);
  s.leadingZero = u8("lz", s.leadingZero, 0, 1);
  s.colonStatus = u8("colon", s.colonStatus, 0, 1);
  s.colorMode = u8("cmode", s.colorMode, 0, CM_CUSTOM);
  bytes("digits", s.digitRgb, sizeof s.digitRgb);
  bytes("ga", s.gradA, sizeof s.gradA);
  bytes("gb", s.gradB, sizeof s.gradB);
  s.gradAngle = i16("gang", s.gradAngle, -180, 180);
  bytes("leds", s.ledRgb, sizeof s.ledRgb);
  s.effect = u8("fx", s.effect, 0, FX_FLASH);
  s.spread = u8("spread", s.spread, 0, SP_LED);
  s.effectAngle = i16("fxang", s.effectAngle, -180, 180);
  s.hueSpan = u16("hue", s.hueSpan, 0, 360);
  s.effectSpeedDs = u16("speed", s.effectSpeedDs, 2, 6000);
  s.flashFadeCs = u16("fade", s.flashFadeCs, 0, 3000);
  s.dateEveryS = u16("dateev", s.dateEveryS, 0, 3600);
  if (s.dateEveryS != 0 && s.dateEveryS < 10) s.dateEveryS = 0;
  s.dateShowMs = u16("datesh", s.dateShowMs, 500, 10000);
  s.dateFormat = u8("datefmt", s.dateFormat, 0, 1);
  s.nightEnabled = u8("night", s.nightEnabled, 0, 1);
  s.nightStartMin = u16("nstart", s.nightStartMin, 0, 1439);
  s.nightEndMin = u16("nend", s.nightEndMin, 0, 1439);
  s.nightBrightness = u8("nbri", s.nightBrightness, 0, 100);
  p.end();
}

// Writes every key. NVS skips a value that is unchanged, so only what moved costs flash.
bool save() {
  const Settings& s = g_settings;
  Preferences p;
  panel::pauseForFlash();
  bool ok = p.begin(impl::NVS_NS, false);
  if (ok) {
    ok = p.putString("ntp", s.ntpServer) > 0;
    // putString returns strlen on success and 0 on failure, so an empty value and a failed
    // write look the same: the only sound test is against the length that was asked for.
    ok = (p.putString("ntp2", s.ntpServer2) == std::strlen(s.ntpServer2)) && ok;
    ok = (p.putString("ntp3", s.ntpServer3) == std::strlen(s.ntpServer3)) && ok;
    ok = p.putBool("ntpfo", s.ntpFailover) > 0 && ok;
    ok = p.putString("host", s.hostname) > 0 && ok;
    ok = p.putString("tz", s.tz) > 0 && ok;
    ok = p.putULong("ival", s.syncIntervalS) > 0 && ok;
    ok = p.putUChar("dst", s.dstMode) > 0 && ok;
    ok = p.putChar("wtx", s.wifiTxDbm) > 0 && ok;
    ok = p.putUChar("wps", s.wifiPsMode) > 0 && ok;
    ok = p.putUChar("on", s.lightOn) > 0 && ok;
    ok = p.putUChar("bri", s.brightness) > 0 && ok;
    ok = p.putUChar("maxi", s.maxCurrent) > 0 && ok;
    ok = p.putBytes("rgb", s.rgb, sizeof s.rgb) == sizeof s.rgb && ok;
    ok = p.putUChar("h12", s.twelveHour) > 0 && ok;
    ok = p.putUChar("blink", s.blinkColon) > 0 && ok;
    ok = p.putUChar("lz", s.leadingZero) > 0 && ok;
    ok = p.putUChar("colon", s.colonStatus) > 0 && ok;
    ok = p.putUChar("cmode", s.colorMode) > 0 && ok;
    ok = p.putBytes("digits", s.digitRgb, sizeof s.digitRgb) == sizeof s.digitRgb && ok;
    ok = p.putBytes("ga", s.gradA, sizeof s.gradA) == sizeof s.gradA && ok;
    ok = p.putBytes("gb", s.gradB, sizeof s.gradB) == sizeof s.gradB && ok;
    ok = p.putShort("gang", s.gradAngle) > 0 && ok;
    ok = p.putBytes("leds", s.ledRgb, sizeof s.ledRgb) == sizeof s.ledRgb && ok;
    ok = p.putUChar("fx", s.effect) > 0 && ok;
    ok = p.putUChar("spread", s.spread) > 0 && ok;
    ok = p.putShort("fxang", s.effectAngle) > 0 && ok;
    ok = p.putUShort("hue", s.hueSpan) > 0 && ok;
    ok = p.putUShort("speed", s.effectSpeedDs) > 0 && ok;
    ok = p.putUShort("fade", s.flashFadeCs) > 0 && ok;
    ok = p.putUShort("dateev", s.dateEveryS) > 0 && ok;
    ok = p.putUShort("datesh", s.dateShowMs) > 0 && ok;
    ok = p.putUChar("datefmt", s.dateFormat) > 0 && ok;
    ok = p.putUChar("night", s.nightEnabled) > 0 && ok;
    ok = p.putUShort("nstart", s.nightStartMin) > 0 && ok;
    ok = p.putUShort("nend", s.nightEndMin) > 0 && ok;
    ok = p.putUChar("nbri", s.nightBrightness) > 0 && ok;
    p.end();
  }
  panel::resumeAfterFlash();
  impl::lastSaveOk_ = ok;
  if (ok) { impl::dirty_ = false; impl::hostStored_ = true; }
  else Serial.println("ERROR: settings save failed");
  return ok;
}

// Display changes arrive while a slider is dragged: written once, SETTINGS_SAVE_DELAY_MS after
// the last one, so a drag costs one flash write instead of fifty.
void markDirty() {
  impl::dirty_ = true;
  impl::dirtySinceMs_ = millis();
}

void loop() {
  if (impl::dirty_ && millis() - impl::dirtySinceMs_ >= SETTINGS_SAVE_DELAY_MS) {
    if (!save()) impl::dirtySinceMs_ = millis();     // retry after another delay
  }
}

bool dirty() { return impl::dirty_; }
bool hostStored() { return impl::hostStored_; }
bool lastSaveOk() { return impl::lastSaveOk_; }

// Clears every stored setting; the next boot starts from the defaults. Wi-Fi is in the sketch.
void factoryReset() {
  Preferences p;
  panel::pauseForFlash();
  if (p.begin(impl::NVS_NS, false)) { p.clear(); p.end(); }
  panel::resumeAfterFlash();
}

}  // namespace settings

// ============================================================================ TIMEKEEPING (SNTP + TZ)

namespace timekeeping {

namespace impl {

char              server_[64];          // lwIP keeps this pointer, so it must stay valid
char              activeTz_[64];        // effective POSIX rule in use
SemaphoreHandle_t tzMutex_ = nullptr;
portMUX_TYPE      mux_ = portMUX_INITIALIZER_UNLOCKED;
time_t            lastSyncEpoch_ = 0;
int64_t           lastSyncUs_ = -1;
int64_t           baseNtpUs_ = 0;       // NTP time at the drift baseline sync, microseconds
int64_t           baseEspUs_ = 0;       // esp_timer at that same sync
bool              haveBase_ = false;
// Mid-point sample. The long baseline gives the low-noise figure; a second sample taken part
// way along gives a recent-window rate, which is what moves when the board's temperature does.
// Without it a rate shift takes as long to show as the whole baseline, because a two-point
// estimate from a fixed origin averages everything since boot.
int64_t           midNtpUs_ = 0;
int64_t           midEspUs_ = 0;
bool              haveMid_ = false;
float             recentPpm_ = 0.0f;
uint32_t          recentSpanS_ = 0;
uint8_t           activeSlot_ = 0;      // which configured server is currently installed
uint32_t          slotSinceMs_ = 0;     // millis() when it was installed
uint32_t          slotSyncCount_ = 0;   // syncCount_ then; proves THIS server replied
float             driftPpm_ = 0.0f;     // crystal fast(+) / slow(-) versus NTP
uint32_t          driftSpanS_ = 0;      // baseline length the figure is measured over
uint32_t          syncCount_ = 0;
uint32_t          intervalS_ = DEFAULT_SYNC_INTERVAL_S;
int64_t           firstSyncUs_ = -1;    // esp_timer at the first sync of this boot

constexpr time_t PLAUSIBLE_EPOCH = 1735689600;   // 2025-01-01T00:00:00Z

// Crystal drift: esp_timer measures elapsed time on the local crystal, NTP measures the real
// elapsed time. The difference over a long baseline is the crystal error.
//
// Every division below is OUTSIDE the lock, deliberately. This chip has no FPU, so each double
// operation is a libgcc call in flash costing tens of microseconds, usually cold - and
// portENTER_CRITICAL masks the display scan interrupt for the whole window. Only the stores are
// protected. Reading the baselines unlocked is safe: this callback is their only writer.
void onSync(struct timeval* tv) {                // runs in the lwIP task
  const int64_t now = esp_timer_get_time();
  const int64_t ntpUs = (int64_t)tv->tv_sec * 1000000LL + (int64_t)tv->tv_usec;

  bool  haveLong = false, haveRecent = false, rollMid = false, setBase = false;
  float longPpm = 0.0f, recentPpm = 0.0f;
  uint32_t longSpan = 0, recentSpan = 0;

  if (!haveBase_) {
    setBase = true;
  } else {
    const int64_t dNtp = ntpUs - baseNtpUs_;
    const int64_t dEsp = now - baseEspUs_;
    if (dNtp > 0) {
      const float ppm = (float)((double)(dEsp - dNtp) * 1000000.0 / (double)dNtp);
      // Outside the sanity limit means a bad packet or a stepped clock, not a real rate.
      if (ppm > -DRIFT_PPM_LIMIT && ppm < DRIFT_PPM_LIMIT) {
        longPpm = ppm; longSpan = (uint32_t)(dNtp / 1000000LL); haveLong = true;
      }
    } else {
      // The baseline is ahead of this reply, so it came from a bad packet - SNTP steps the
      // clock to whatever arrives and nothing upstream range-checks it. Left alone this is
      // permanent: dNtp stays negative for the life of the boot and no figure is ever produced
      // again. Re-anchor here instead.
      setBase = true;
    }
    if (haveMid_) {
      const int64_t rNtp = ntpUs - midNtpUs_;
      const int64_t rEsp = now - midEspUs_;
      if (rNtp >= (int64_t)DRIFT_RECENT_MIN_SPAN_S * 1000000LL) {
        const float ppm = (float)((double)(rEsp - rNtp) * 1000000.0 / (double)rNtp);
        if (ppm > -DRIFT_PPM_LIMIT && ppm < DRIFT_PPM_LIMIT) {
          recentPpm = ppm; recentSpan = (uint32_t)(rNtp / 1000000LL); haveRecent = true;
        }
        rollMid = true;
      } else if (rNtp < 0) {
        rollMid = true;
      }
    } else {
      rollMid = true;
    }
  }

  portENTER_CRITICAL(&mux_);
  lastSyncEpoch_ = tv->tv_sec;
  lastSyncUs_ = now;
  if (firstSyncUs_ < 0) firstSyncUs_ = now;
  ++syncCount_;
  if (setBase)    { baseNtpUs_ = ntpUs; baseEspUs_ = now; haveBase_ = true; driftSpanS_ = 0; }
  if (haveLong)   { driftPpm_ = longPpm; driftSpanS_ = longSpan; }
  if (haveRecent) { recentPpm_ = recentPpm; recentSpanS_ = recentSpan; }
  if (rollMid)    { midNtpUs_ = ntpUs; midEspUs_ = now; haveMid_ = true; }
  portEXIT_CRITICAL(&mux_);
}

}  // namespace impl

void setTz(const char* tz) {
  xSemaphoreTake(impl::tzMutex_, portMAX_DELAY);
  std::strncpy(impl::activeTz_, tz, sizeof impl::activeTz_ - 1);
  impl::activeTz_[sizeof impl::activeTz_ - 1] = '\0';
  setenv("TZ", impl::activeTz_, 1);
  tzset();
  xSemaphoreGive(impl::tzMutex_);
}

void begin(const char* ntpServer, const char* tz, uint32_t intervalS) {
  if (!impl::tzMutex_) impl::tzMutex_ = xSemaphoreCreateMutex();
  std::strncpy(impl::server_, ntpServer, sizeof impl::server_ - 1);
  impl::server_[sizeof impl::server_ - 1] = '\0';
  impl::intervalS_ = intervalS;
  setTz(tz);
}

// (Re)start SNTP: one server, no fallbacks, no DHCP-supplied servers, immediate request.
// The configured server for one of our slots, or an empty string if that slot is unused.
const char* slotServer(uint8_t i) {
  if (i == 1) return g_settings.ntpServer2;
  if (i == 2) return g_settings.ntpServer3;
  return g_settings.ntpServer;
}

bool slotUsable(uint8_t i) {
  if (i > 0 && !g_settings.ntpFailover) return false;   // failover off: only slot 0 exists
  return slotServer(i)[0] != '\0';
}

// (Re)start SNTP with exactly ONE server - whichever slot is active - in lwIP slot 0, every
// other slot cleared. lwIP's own selection is round-robin and sticky, so a single timeout on
// the primary would demote it permanently; with no other slot populated its index cannot move
// and the policy is entirely ours. The pointer lwIP keeps is always impl::server_, one buffer
// that outlives every restart, so a settings edit cannot move a string it may be resolving.
void restart() {
  if (esp_sntp_enabled()) esp_sntp_stop();
  esp_sntp_setoperatingmode(ESP_SNTP_OPMODE_POLL);
#if CONFIG_LWIP_DHCP_GET_NTP_SRV
  esp_sntp_servermode_dhcp(false);
#endif
  esp_sntp_setservername(0, impl::server_);
  for (uint8_t i = 1; i < CONFIG_LWIP_SNTP_MAX_SERVERS; ++i)
    esp_sntp_setserver(i, nullptr);                // clears address and name: no fallbacks
  sntp_set_sync_mode(SNTP_SYNC_MODE_IMMED);        // step the clock, do not slew
  sntp_set_sync_interval(impl::intervalS_ * 1000UL);
  sntp_set_time_sync_notification_cb(impl::onSync);
  esp_sntp_init();
}

// Install one of our slots as the single lwIP server.
void selectSlot(uint8_t slot) {
  if (slot >= NTP_SERVER_SLOTS) slot = 0;
  const char* name = slotServer(slot);
  if (name[0] == '\0') { slot = 0; name = slotServer(0); }
  if (name[0] == '\0') return;                     // nothing configured at all
  if (esp_sntp_enabled()) esp_sntp_stop();
  std::strncpy(impl::server_, name, sizeof impl::server_ - 1);
  impl::server_[sizeof impl::server_ - 1] = '\0';
  impl::activeSlot_ = slot;
  impl::slotSinceMs_ = millis();
  portENTER_CRITICAL(&impl::mux_);
  impl::slotSyncCount_ = impl::syncCount_;
  portEXIT_CRITICAL(&impl::mux_);
  restart();
}

uint8_t  activeSlot()    { return impl::activeSlot_; }
uint32_t slotSinceMs()   { return impl::slotSinceMs_; }
uint32_t slotSyncCount() { return impl::slotSyncCount_; }

// The next usable slot after `from`, wrapping. Returns `from` when nothing else is configured,
// so a lone-server setup degenerates into a plain restart rather than a special case.
uint8_t nextUsableSlot(uint8_t from) {
  for (uint8_t step = 1; step <= NTP_SERVER_SLOTS; ++step) {
    const uint8_t cand = (uint8_t)((from + step) % NTP_SERVER_SLOTS);
    if (slotUsable(cand)) return cand;
  }
  return from;
}

// Editing a server is an explicit statement of intent, so it re-anchors on the primary rather
// than leaving the device on a fallback it was sent to before the change.
void setServer(const char* ntpServer) {
  if (esp_sntp_enabled()) esp_sntp_stop();         // stop before the buffer changes
  std::strncpy(impl::server_, ntpServer, sizeof impl::server_ - 1);
  impl::server_[sizeof impl::server_ - 1] = '\0';
  impl::activeSlot_ = 0;
  impl::slotSinceMs_ = millis();
  portENTER_CRITICAL(&impl::mux_);
  impl::slotSyncCount_ = impl::syncCount_;
  portEXIT_CRITICAL(&impl::mux_);
  restart();
}

void setSyncInterval(uint32_t intervalS) {
  impl::intervalS_ = intervalS;
  sntp_set_sync_interval(intervalS * 1000UL);
  if (esp_sntp_enabled()) sntp_restart();          // apply now instead of after the old interval
}

// Immediate poll without changing any setting.
bool syncNow() {
  if (!esp_sntp_enabled()) { restart(); return true; }
  return sntp_restart();
}

bool localNow(std::tm& out, time_t* epoch = nullptr) {
  const time_t now = time(nullptr);
  if (epoch) *epoch = now;
  xSemaphoreTake(impl::tzMutex_, portMAX_DELAY);
  localtime_r(&now, &out);
  xSemaphoreGive(impl::tzMutex_);
  return now >= impl::PLAUSIBLE_EPOCH;
}

void toLocal(time_t epoch, std::tm& out) {
  xSemaphoreTake(impl::tzMutex_, portMAX_DELAY);
  localtime_r(&epoch, &out);
  xSemaphoreGive(impl::tzMutex_);
}

uint32_t syncCount() {
  portENTER_CRITICAL(&impl::mux_);
  const uint32_t n = impl::syncCount_;
  portEXIT_CRITICAL(&impl::mux_);
  return n;
}

bool everSynced() { return syncCount() > 0; }

// Measured crystal drift versus NTP. Valid once the baseline is long enough to be meaningful.
// Valid once the baseline is long enough for the figure to beat its own noise. The old gate
// was 300 s, where a two-point estimate carries about +/- 67 ppm of uncertainty - larger than
// the quantity it measures, which is why a cold boot used to report figures like 127 ppm.
bool     driftValid() { return impl::driftSpanS_ >= DRIFT_VALID_SPAN_S; }
float    driftRecentPpm()   { return impl::recentPpm_; }
uint32_t driftRecentSpanS() { return impl::recentSpanS_; }

// One-sigma uncertainty of the current estimate, in ppm. NEGATIVE when nothing has been
// measured at all: returning 0 there reads exactly like a perfectly measured zero.
float driftUncertaintyPpm() {
  const uint32_t span = impl::driftSpanS_;
  if (span == 0) return -1.0f;
  return (2.0f * DRIFT_SYNC_JITTER_US) / (float)span;
}
float    driftPpm()   { return impl::driftPpm_; }
uint32_t driftSpanS() { return impl::driftSpanS_; }

time_t lastSyncEpoch() {
  portENTER_CRITICAL(&impl::mux_);
  const time_t t = impl::lastSyncEpoch_;
  portEXIT_CRITICAL(&impl::mux_);
  return t;
}

int64_t lastSyncAgeUs() {
  portENTER_CRITICAL(&impl::mux_);
  const int64_t t = impl::lastSyncUs_;
  portEXIT_CRITICAL(&impl::mux_);
  return t < 0 ? -1 : esp_timer_get_time() - t;
}

// Milliseconds from start-up to the first sync of this boot, -1 until then.
int32_t firstSyncMs() {
  portENTER_CRITICAL(&impl::mux_);
  const int64_t t = impl::firstSyncUs_;
  portEXIT_CRITICAL(&impl::mux_);
  return t < 0 ? -1 : (int32_t)(t / 1000);
}

uint32_t syncIntervalS() { return impl::intervalS_; }
const char* server() { return impl::server_; }
const char* activeTz() { return impl::activeTz_; }

}  // namespace timekeeping

// ============================================================================ WI-FI CREDENTIALS
//
// Kept in their own NVS namespace, which a factory reset does not clear, so neither a reset nor a
// firmware update can take a clock off its network. Real details in the sketch always win.

namespace netcfg {

namespace impl {

const char* const NS = "hu058net";
const char* const PLACEHOLDER_SSID = "your-ssid";
char ssid_[33];
char pass_[65];
char savedSsid_[33];
char savedPass_[65];
bool haveSaved_ = false;
bool fromSketch_ = false;

}  // namespace impl

bool sketchHasWifi() {
  return WIFI_SSID[0] != '\0' && std::strcmp(WIFI_SSID, impl::PLACEHOLDER_SSID) != 0;
}

void begin() {
  impl::savedSsid_[0] = impl::savedPass_[0] = '\0';
  Preferences p;
  if (p.begin(impl::NS, true)) {
    // getString returns 0 on any failure and the length with its terminator otherwise, so an
    // empty password (open network) still reads as present.
    if (p.isKey("ssid") && p.isKey("pass") &&
        p.getString("ssid", impl::savedSsid_, sizeof impl::savedSsid_) > 1 &&
        p.getString("pass", impl::savedPass_, sizeof impl::savedPass_) > 0) {
      impl::haveSaved_ = true;
    } else {
      impl::savedSsid_[0] = impl::savedPass_[0] = '\0';
    }
    p.end();
  }
  impl::fromSketch_ = sketchHasWifi();
  if (impl::fromSketch_) {
    util::copyStr(impl::ssid_, sizeof impl::ssid_, WIFI_SSID);
    util::copyStr(impl::pass_, sizeof impl::pass_, WIFI_PASSWORD);
  } else {
    util::copyStr(impl::ssid_, sizeof impl::ssid_, impl::savedSsid_);
    util::copyStr(impl::pass_, sizeof impl::pass_, impl::savedPass_);
  }
  if (impl::fromSketch_) Serial.printf("Wi-Fi %s (from the sketch)\n", impl::ssid_);
  else if (impl::haveSaved_) Serial.printf("Wi-Fi %s (saved from an earlier build)\n", impl::ssid_);
  else Serial.println("ERROR: no Wi-Fi set. Put WIFI_SSID and WIFI_PASSWORD in the sketch and flash over USB.");
}

bool configured() { return impl::ssid_[0] != '\0'; }
const char* ssid() { return impl::ssid_; }
const char* pass() { return impl::pass_; }
const char* source() { return impl::fromSketch_ ? "sketch" : (impl::haveSaved_ ? "saved" : "none"); }

// After a successful join with details from the sketch: remember them, unless already saved.
void rememberIfNew() {
  if (!impl::fromSketch_) return;
  if (impl::haveSaved_ && std::strcmp(impl::savedSsid_, impl::ssid_) == 0 &&
      std::strcmp(impl::savedPass_, impl::pass_) == 0) return;
  Preferences p;
  panel::pauseForFlash();
  bool ok = p.begin(impl::NS, false);
  if (ok) {
    ok = p.putString("ssid", impl::ssid_) == std::strlen(impl::ssid_);
    ok = (p.putString("pass", impl::pass_) == std::strlen(impl::pass_)) && ok;
    p.end();
  }
  panel::resumeAfterFlash();
  if (!ok) { Serial.println("ERROR: Wi-Fi details could not be saved"); return; }
  util::copyStr(impl::savedSsid_, sizeof impl::savedSsid_, impl::ssid_);
  util::copyStr(impl::savedPass_, sizeof impl::savedPass_, impl::pass_);
  impl::haveSaved_ = true;
  Serial.println("Wi-Fi details saved: builds with the placeholder details keep this network");
}

}  // namespace netcfg

// ============================================================================ WI-FI MANAGER
//
// The device never stops trying to reconnect. Retries back off from WIFI_RETRY_MIN_MS to
// WIFI_RETRY_MAX_MS, and every WIFI_RADIO_RESET_TRIES failures the radio is taken down and
// brought back up, which clears driver states that a plain begin() does not.

namespace wifimgr {

struct Stats {
  uint32_t connects;
  uint32_t disconnects;
  uint32_t retries;
  uint32_t radioResets;
  uint8_t  lastReason;
  uint32_t downSinceMs;     // millis() when the link was last lost, 0 while connected
};

namespace impl {

Stats    stats_ = {};
uint32_t lastAttemptMs_ = 0;
uint32_t retryDelayMs_ = WIFI_RETRY_MIN_MS;
bool     txApplied_ = false;
uint32_t failStreak_ = 0;
volatile bool gotIp_ = false;
volatile int32_t firstIpMs_ = -1;    // millis() at the first IP address of this boot

void onEvent(arduino_event_id_t event, arduino_event_info_t info) {
  switch (event) {
    case ARDUINO_EVENT_WIFI_STA_GOT_IP:
      ++stats_.connects;
      stats_.downSinceMs = 0;
      failStreak_ = 0;
      retryDelayMs_ = WIFI_RETRY_MIN_MS;
      gotIp_ = true;
      if (firstIpMs_ < 0) firstIpMs_ = (int32_t)millis();
      break;
    case ARDUINO_EVENT_WIFI_STA_DISCONNECTED:
      ++stats_.disconnects;
      stats_.lastReason = info.wifi_sta_disconnected.reason;
      if (!stats_.downSinceMs) {
        const uint32_t t = millis();
        stats_.downSinceMs = t ? t : 1;
      }
      break;
    default:
      break;
  }
}

}  // namespace impl

const char* reasonName(uint8_t reason) {
  switch (reason) {
    case 0:   return "none";
    case 1:   return "unspecified";
    case 2:   return "auth expired";
    case 4:   return "association expired";
    case 8:   return "AP dropped us";
    case 15:  return "4-way handshake timeout (check the password)";
    case 200: return "beacon timeout";
    case 201: return "no AP found";
    case 202: return "auth failed";
    case 203: return "association failed";
    case 204: return "handshake timeout";
    case 205: return "connection failed";
    default:  return "see esp_wifi_types.h";
  }
}

// Both knobs revert to their defaults whenever the radio restarts, so this runs after every
// STA start, not once at boot. setTxPower needs the station already started or it refuses.
void applyRadioPower() {
  const wifi_ps_type_t ps = g_settings.wifiPsMode == 2 ? WIFI_PS_MAX_MODEM
                          : g_settings.wifiPsMode == 1 ? WIFI_PS_MIN_MODEM
                                                       : WIFI_PS_NONE;
  WiFi.setSleep(ps);
  esp_wifi_set_ps(ps);
  // 0.25 dBm units. quantiseTxDbm has already snapped the value to a producible step.
  const int8_t q = (int8_t)(g_settings.wifiTxDbm * 4);
  impl::txApplied_ = WiFi.setTxPower((wifi_power_t)q);
}

void begin() {
  WiFi.persistent(false);                 // credentials are kept by netcfg, not the driver
  WiFi.setHostname(g_settings.hostname);  // must precede WiFi.mode()
  WiFi.onEvent(impl::onEvent);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  if (!netcfg::configured()) return;      // nothing to join; loop() stays idle too
  WiFi.begin(netcfg::ssid(), netcfg::pass());
  applyRadioPower();
  const uint32_t t = millis();
  impl::lastAttemptMs_ = t;
  impl::stats_.downSinceMs = t ? t : 1;
}

void loop() {
  const uint32_t now = millis();
  if (!netcfg::configured()) return;
  if (WiFi.isConnected()) {
    impl::retryDelayMs_ = WIFI_RETRY_MIN_MS;
    impl::failStreak_ = 0;
    return;
  }
  if (now - impl::lastAttemptMs_ < impl::retryDelayMs_) return;
  impl::lastAttemptMs_ = now;
  ++impl::stats_.retries;
  ++impl::failStreak_;

  if (impl::failStreak_ % WIFI_RADIO_RESET_TRIES == 0) {
    ++impl::stats_.radioResets;
    WiFi.disconnect(true, false);
    WiFi.mode(WIFI_OFF);
    delay(100);
    WiFi.mode(WIFI_STA);
  }
  WiFi.begin(netcfg::ssid(), netcfg::pass());
  applyRadioPower();

  impl::retryDelayMs_ *= 2;
  if (impl::retryDelayMs_ > WIFI_RETRY_MAX_MS) impl::retryDelayMs_ = WIFI_RETRY_MAX_MS;
}

// What the radio reports back, not what we asked for. 0 when the station is not started.
int8_t actualTxDbm() {
  if (!WiFi.isConnected()) return 0;
  const int v = (int)WiFi.getTxPower();
  return (int8_t)(v / 4);
}
bool txApplied() { return impl::txApplied_; }

// True once per new IP; clears the flag.
bool takeGotIp() {
  if (!impl::gotIp_) return false;
  impl::gotIp_ = false;
  return true;
}

void getStats(Stats& out) { out = impl::stats_; }
int32_t firstIpMs() { return impl::firstIpMs_; }
uint32_t retryDelayMs() { return impl::retryDelayMs_; }

uint32_t downSeconds() {
  if (WiFi.isConnected() || !impl::stats_.downSinceMs) return 0;
  return (millis() - impl::stats_.downSinceMs) / 1000;
}

}  // namespace wifimgr

// ============================================================================ CLOCK FACE

namespace clockface {

enum class Mode : uint8_t { TIME, SECONDS, DATE, NUMBER, TEXT, LAMP };

constexpr uint8_t SEQ_MAX = 8;
struct TextStep { char text[5]; uint16_t ms; };

Mode     mode_ = Mode::TIME;
uint32_t modeUntil_ = 0;
int      number_ = 0;
char     unit_ = '\0';
TextStep seq_[SEQ_MAX];
uint8_t  seqLen_ = 0;
uint8_t  seqPos_ = 0;
uint32_t seqStepAt_ = 0;
time_t   lastDateEpoch_ = 0;
bool     blank_ = false;          // OTA in progress
bool     nightActive_ = false;

// Colour state derived from settings. effectRgb_ is written by the cycle effect.
float    gradRgb_[4][9][3];
float    effectRgb_[4][9][3];
float    axisLed_[4][9];
float    axisBlk_[4];
float    envelope_ = 1.0f;
uint32_t effectT0_ = 0;
uint32_t effectAt_ = 0;
bool     colorsDirty_ = true;
uint8_t  lastEffect_ = 0xFF;

uint32_t lifetime(long ms) {
  if (ms < (long)TEMP_MODE_MIN_MS) return TEMP_MODE_MIN_MS;
  if (ms > (long)TEMP_MODE_MAX_MS) return TEMP_MODE_MAX_MS;
  return (uint32_t)ms;
}

void enterMode(Mode m, long ms) {
  mode_ = m;
  modeUntil_ = millis() + lifetime(ms);
  colorsDirty_ = true;                             // lamp test changes colours and current
}

void showSeconds(long ms) { enterMode(Mode::SECONDS, ms); }
void showDate(long ms) { enterMode(Mode::DATE, ms); }
void lampTest(long ms) { enterMode(Mode::LAMP, ms); }

void showNumber(int value, char unit, long ms) {
  number_ = value;
  unit_ = unit;
  enterMode(Mode::NUMBER, ms);
}

// A sequence of up to SEQ_MAX four-character frames, then back to the time.
void showSequence(const char* const* texts, const uint16_t* ms, uint8_t n) {
  if (n == 0) return;
  if (n > SEQ_MAX) n = SEQ_MAX;
  uint32_t total = 0;
  for (uint8_t i = 0; i < n; ++i) {
    util::copyStr(seq_[i].text, sizeof seq_[i].text, texts[i]);
    seq_[i].ms = ms[i] < TEMP_MODE_MIN_MS ? (uint16_t)TEMP_MODE_MIN_MS : ms[i];
    total += seq_[i].ms;
  }
  seqLen_ = n;
  seqPos_ = 0;
  seqStepAt_ = millis() + seq_[0].ms;
  enterMode(Mode::TEXT, (long)total);
}

void showText(const char* text, long ms) {
  const char* t[1] = { text };
  const uint16_t d[1] = { (uint16_t)lifetime(ms > 60000 ? 60000 : ms) };
  showSequence(t, d, 1);
}

// Right-align `s` into a four-character frame.
void rightAlign(const char* s, char out[5]) {
  const size_t n = std::strlen(s);
  std::memset(out, ' ', 4);
  out[4] = '\0';
  const size_t take = n > 4 ? 4 : n;
  std::memcpy(out + (4 - take), s + (n - take), take);
}

// IP address octet by octet, or "no nEt" while Wi-Fi is down.
void showIp() {
  if (!WiFi.isConnected()) {
    const char* t[2] = { "  no", " nEt" };
    const uint16_t d[2] = { 1200, 1200 };
    showSequence(t, d, 2);
    return;
  }
  const IPAddress ip = WiFi.localIP();
  char octets[4][5];
  const char* texts[5];
  uint16_t ms[5];
  uint8_t n = 0;
  texts[n] = " IP "; ms[n++] = 1000;
  for (int i = 0; i < 4; ++i) {
    char num[5];
    std::snprintf(num, sizeof num, "%u", (unsigned)ip[i]);
    rightAlign(num, octets[i]);
    texts[n] = octets[i]; ms[n++] = 1300;
  }
  showSequence(texts, ms, n);
}

// Time is being kept honestly: link up and a sync within NTP_HEALTH_MULT poll intervals,
// floored at NTP_HEALTH_MIN_S.
bool syncHonest() {
  if (!WiFi.isConnected()) return false;
  const int64_t age = timekeeping::lastSyncAgeUs();
  if (age < 0) return false;
  uint64_t windowS = (uint64_t)timekeeping::syncIntervalS() * NTP_HEALTH_MULT;
  if (windowS < NTP_HEALTH_MIN_S) windowS = NTP_HEALTH_MIN_S;
  return (uint64_t)age <= windowS * 1000000ULL;
}

void setBlank(bool b) {
  blank_ = b;
  if (b) panel::blankNow();
  colorsDirty_ = true;
}

bool inNight(const std::tm& t) {
  if (!g_settings.nightEnabled) return false;
  const uint16_t m = (uint16_t)(t.tm_hour * 60 + t.tm_min);
  const uint16_t a = g_settings.nightStartMin, b = g_settings.nightEndMin;
  if (a == b) return false;
  return a < b ? (m >= a && m < b) : (m >= a || m < b);
}

void markColorsDirty() { colorsDirty_ = true; }

// Recompute everything that depends on settings but not on time: gradient and effect axis.
void settingsChanged() {
  float perLed[4][9], perBlk[4];
  face::projectAxis((float)g_settings.gradAngle, perLed, perBlk);
  for (int b = 0; b < 4; ++b)
    for (int s = 0; s < 9; ++s)
      for (int c = 0; c < 3; ++c) {
        const float a = g_settings.gradA[c] / 255.0f, z = g_settings.gradB[c] / 255.0f;
        gradRgb_[b][s][c] = a + (z - a) * perLed[b][s];
      }
  face::projectAxis((float)g_settings.effectAngle, axisLed_, axisBlk_);
  if (g_settings.effect != lastEffect_) {
    lastEffect_ = g_settings.effect;
    effectT0_ = millis();
    effectAt_ = 0;
    envelope_ = 1.0f;
  }
  colorsDirty_ = true;
}

// Colour of one position before the effect envelope, 0..1 per channel.
void schemeColor(int b, int s, float out[3]) {
  const uint8_t id = face::GEOM[b][s].id;
  switch (g_settings.colorMode) {
    case CM_DIGIT:
      for (int c = 0; c < 3; ++c) out[c] = g_settings.digitRgb[b][c] / 255.0f;
      return;
    case CM_GRADIENT:
      for (int c = 0; c < 3; ++c) out[c] = gradRgb_[b][s][c];
      return;
    case CM_CUSTOM:
      if (id >= 1 && id <= face::LED_COUNT) {
        for (int c = 0; c < 3; ++c) out[c] = g_settings.ledRgb[id - 1][c] / 255.0f;
        return;
      }
      break;
    default:
      break;
  }
  // Solid: normalised so the largest component is full, brightness lives in the current.
  const uint8_t mx = g_settings.rgb[0] > g_settings.rgb[1] ? (g_settings.rgb[0] > g_settings.rgb[2] ? g_settings.rgb[0] : g_settings.rgb[2])
                                                           : (g_settings.rgb[1] > g_settings.rgb[2] ? g_settings.rgb[1] : g_settings.rgb[2]);
  for (int c = 0; c < 3; ++c) out[c] = mx ? (float)g_settings.rgb[c] / (float)mx : 0.0f;
}

void applyColors() {
  if (mode_ == Mode::LAMP) {
    for (auto& blk : panel::level_) for (auto& seg : blk) for (uint8_t& ch : seg) ch = face::COLOR_LEVELS - 1;
  } else {
    for (int b = 0; b < 4; ++b)
      for (int s = 0; s < 9; ++s) {
        float c[3];
        if (g_settings.effect == FX_CYCLE && face::GEOM[b][s].id) { c[0] = effectRgb_[b][s][0]; c[1] = effectRgb_[b][s][1]; c[2] = effectRgb_[b][s][2]; }
        else schemeColor(b, s, c);
        panel::level_[b][s][face::CH_RED]   = face::dutyLevel(c[0] * envelope_);
        panel::level_[b][s][face::CH_GREEN] = face::dutyLevel(c[1] * envelope_);
        panel::level_[b][s][face::CH_BLUE]  = face::dutyLevel(c[2] * envelope_);
      }
  }
  // Current from brightness alone, never from what is lit. Max current is the ceiling everywhere.
  uint8_t want;
  if (mode_ == Mode::LAMP) want = face::currentFor(LAMP_TEST_BRIGHTNESS / 100.0f);
  else {
    const uint8_t pct = nightActive_ && g_settings.nightBrightness ? g_settings.nightBrightness : g_settings.brightness;
    want = face::currentFor(pct / 100.0f);
  }
  panel::is_ = want < g_settings.maxCurrent ? want : g_settings.maxCurrent;
}

void updateEffect(uint32_t nowMs) {
  // Phase in integer milliseconds: a float of elapsed seconds loses sub-second resolution after
  // a few days of uptime and the animation would start to stutter.
  const uint32_t periodMs = (uint32_t)g_settings.effectSpeedDs * 100UL;
  const float period = periodMs / 1000.0f;
  const float phase = (float)((nowMs - effectT0_) % periodMs) / (float)periodMs;
  if (g_settings.effect == FX_FLASH) {
    // Trapezoid: rate and transition time are independent; ramps eat into the halves.
    const float half = period * 0.5f;
    float f = g_settings.flashFadeCs / 100.0f;
    if (f > half) f = half;
    const float t = phase * period;
    float e;
    if (f <= 0.0f) e = t < half ? 1.0f : 0.0f;
    else if (t < f) e = t / f;
    else if (t < half) e = 1.0f;
    else if (t < half + f) e = 1.0f - (t - half) / f;
    else e = 0.0f;
    envelope_ = e;
  } else if (g_settings.effect == FX_CYCLE) {
    envelope_ = 1.0f;
    const float span = g_settings.hueSpan / 360.0f;
    for (int b = 0; b < 4; ++b)
      for (int s = 0; s < 9; ++s) {
        if (!face::GEOM[b][s].id) continue;
        const float t = g_settings.spread == SP_PANEL ? 0.0f : g_settings.spread == SP_DIGIT ? axisBlk_[b] : axisLed_[b][s];
        face::hueRgb(phase + t * span, effectRgb_[b][s]);
      }
  } else {
    envelope_ = 1.0f;
  }
  colorsDirty_ = true;
}

void writeDigit(bool on[4][9], int block, char c) {
  const uint8_t bits = face::glyph(c);
  for (int s = 0; s < 7; ++s) on[block][s] = (bits >> s) & 1;
}

void writeText(bool on[4][9], const char* t) {
  for (int i = 0; i < 4 && t[i]; ++i) writeDigit(on, i, t[i]);
}

// Right aligned, unit in the rightmost position; C and F light the degree mark.
void drawNumber(bool on[4][9], int value, char unit) {
  int pos = 3;
  if (unit != '\0' && face::glyph(unit) != 0) {
    writeDigit(on, 3, unit);
    pos = 2;
    if (unit == 'C' || unit == 'c' || unit == 'F') on[3][face::SEG_ANNUN] = true;
  }
  const bool neg = value < 0;
  long v = neg ? -(long)value : (long)value;
  const int room = pos + 1 - (neg ? 1 : 0);
  long limit = 1;
  for (int i = 0; i < room; ++i) limit *= 10;
  if (v > limit - 1) v = limit - 1;
  do {
    writeDigit(on, pos--, (char)('0' + v % 10));
    v /= 10;
  } while (v > 0 && pos >= 0);
  if (neg && pos >= 0) writeDigit(on, pos, '-');
}

// Clock face dark: switched off, or night mode with night brightness 0.
bool faceOff() {
  return !g_settings.lightOn || (nightActive_ && g_settings.nightBrightness == 0);
}

// Build the face for this instant. Returns into `on`.
void compose(bool on[4][9]) {
  std::memset(on, 0, sizeof(bool) * 4 * 9);
  if (blank_) return;
  if (mode_ == Mode::LAMP) {
    for (int b = 0; b < 4; ++b) for (int s = 0; s < 9; ++s) on[b][s] = face::GEOM[b][s].id != 0;
    return;
  }
  // Explicit temporary displays (button feedback, IP, web actions) show even while the face is
  // switched off or dark for the night; only the normal clock face obeys those.
  if (mode_ == Mode::NUMBER) { drawNumber(on, number_, unit_); return; }
  if (mode_ == Mode::TEXT) { writeText(on, seq_[seqPos_].text); return; }
  if (mode_ == Mode::TIME && faceOff()) return;

  std::tm t;
  const bool valid = timekeeping::localNow(t);
  const bool honest = syncHonest();

  if (!valid) {                                    // no time yet: waiting for the first sync
    writeText(on, "----");
    return;
  }

  if (mode_ == Mode::SECONDS) {
    writeDigit(on, 2, (char)('0' + t.tm_sec / 10));
    writeDigit(on, 3, (char)('0' + t.tm_sec % 10));
    if (!g_settings.colonStatus || honest) on[1][face::SEG_ANNUN] = true;
    on[1][face::SEG_ANNUN2] = true;
    return;
  }

  if (mode_ == Mode::DATE) {
    const int mon = t.tm_mon + 1, day = t.tm_mday;
    const int first = g_settings.dateFormat ? day : mon;
    const int second = g_settings.dateFormat ? mon : day;
    if (first >= 10 || g_settings.leadingZero) writeDigit(on, 0, (char)('0' + first / 10));
    writeDigit(on, 1, (char)('0' + first % 10));
    writeDigit(on, 2, (char)('0' + second / 10));
    writeDigit(on, 3, (char)('0' + second % 10));
    on[2][face::SEG_ANNUN] = true;                 // date dash
    return;
  }

  int hour = t.tm_hour;
  const bool pm = hour >= 12;
  if (g_settings.twelveHour) {
    hour %= 12;
    if (hour == 0) hour = 12;
  }
  if (hour >= 10 || (g_settings.leadingZero && !g_settings.twelveHour)) writeDigit(on, 0, (char)('0' + hour / 10));
  writeDigit(on, 1, (char)('0' + hour % 10));
  writeDigit(on, 2, (char)('0' + t.tm_min / 10));
  writeDigit(on, 3, (char)('0' + t.tm_min % 10));
  // Steady colon when blink is off. With the colon status option on, the upper dot only lights
  // while time is being kept honest, so a lone lower dot means free running on the crystal.
  const bool colon = g_settings.blinkColon ? ((time(nullptr) % 2) == 0) : true;
  if (colon) {
    if (!g_settings.colonStatus || honest) on[1][face::SEG_ANNUN] = true;
    on[1][face::SEG_ANNUN2] = true;
  }
  if (g_settings.twelveHour && !pm) on[0][face::SEG_ANNUN] = true;   // AM mark
}

bool     shown_[4][9];
uint32_t lastComposeMs_ = 0;
time_t   lastSecond_ = 0;

void loop() {
  const uint32_t now = millis();

  if (g_settings.effect != FX_NONE && (int32_t)(now - effectAt_) >= 0) {
    effectAt_ = now + EFFECT_PERIOD_MS;
    updateEffect(now);
  } else if (g_settings.effect == FX_NONE && envelope_ != 1.0f) {
    envelope_ = 1.0f;
    colorsDirty_ = true;
  }

  // The time redraws the moment the second changes, checked every loop pass (a few ms), instead
  // of up to DISPLAY_PERIOD_MS later. That period now only paces temporary displays and night.
  const time_t second = time(nullptr);
  const bool newSecond = second != lastSecond_;
  if (!newSecond && !colorsDirty_ && now - lastComposeMs_ < DISPLAY_PERIOD_MS) return;
  lastSecond_ = second;
  lastComposeMs_ = now;

  // Night window and periodic date need the local time.
  std::tm t;
  time_t epoch = 0;
  const bool valid = timekeeping::localNow(t, &epoch);
  const bool night = valid && inNight(t);
  if (night != nightActive_) { nightActive_ = night; colorsDirty_ = true; }

  if (mode_ == Mode::TEXT && seqPos_ + 1 < seqLen_ && (int32_t)(now - seqStepAt_) >= 0) {
    ++seqPos_;
    seqStepAt_ = now + seq_[seqPos_].ms;
  }
  if (mode_ != Mode::TIME && (int32_t)(now - modeUntil_) >= 0) {
    const bool wasLamp = mode_ == Mode::LAMP;
    mode_ = Mode::TIME;
    if (wasLamp) colorsDirty_ = true;
  }
  if (valid && mode_ == Mode::TIME && !faceOff() && g_settings.dateEveryS && epoch != lastDateEpoch_ &&
      (epoch % g_settings.dateEveryS) == 0) {
    lastDateEpoch_ = epoch;
    showDate(g_settings.dateShowMs);
  }

  bool next[4][9];
  compose(next);
  const bool changed = std::memcmp(next, shown_, sizeof shown_) != 0;
  if (!changed && !colorsDirty_) return;
  if (colorsDirty_) { applyColors(); colorsDirty_ = false; }
  std::memcpy(shown_, next, sizeof shown_);
  std::memcpy(panel::on_, next, sizeof next);
  panel::render();
}

const char* modeName() {
  switch (mode_) {
    case Mode::SECONDS: return "seconds";
    case Mode::DATE:    return "date";
    case Mode::NUMBER:  return "number";
    case Mode::TEXT:    return "text";
    case Mode::LAMP:    return "lamp";
    default:            return "time";
  }
}

bool nightActive() { return nightActive_; }
uint8_t currentStep() { return panel::is_; }

}  // namespace clockface

// ============================================================================ NETWORK SERVICES (mDNS, ArduinoOTA)

namespace services {

bool mdnsStarted_ = false;
bool otaStarted_ = false;

// Called on every new IP address. mDNS is started here (NtpClockMod) and ArduinoOTA is told not
// to start its own, so the name is registered once.
void onGotIp() {
  if (!mdnsStarted_ && MDNS.begin(g_settings.hostname)) {
    MDNS.addService("http", "tcp", 80);
    mdnsStarted_ = true;
  }
  if (otaStarted_) return;
  ArduinoOTA.setHostname(g_settings.hostname);
  ArduinoOTA.setMdnsEnabled(false);
  if (std::strlen(OTA_PASSWORD)) ArduinoOTA.setPassword(OTA_PASSWORD);
  // handle() blocks for the whole transfer and restarts on success. The scan is stopped and the
  // panel dark for the duration, as for every other flash write.
  ArduinoOTA.onStart([] {
    Serial.println("[ota] IDE upload started");
    clockface::setBlank(true);
    panel::pauseForFlash();
  });
  ArduinoOTA.onError([](ota_error_t e) {
    Serial.printf("[ota] IDE upload failed (%d)\n", (int)e);
    panel::resumeAfterFlash();
    clockface::setBlank(false);
  });
  ArduinoOTA.begin();
  if (mdnsStarted_) MDNS.enableArduino(3232, std::strlen(OTA_PASSWORD) > 0);
  otaStarted_ = true;
}

void loop() {
  if (otaStarted_) ArduinoOTA.handle();
}

}  // namespace services

// ============================================================================ BUTTONS

namespace buttons {

const uint8_t BRIGHTNESS_STEPS[] = { BRIGHTNESS_STEPS_LIST };

struct Btn {
  uint8_t  pin;
  bool     down;          // debounced, true = pressed
  bool     raw;
  uint32_t rawSinceMs;
  uint32_t downAtMs;
  bool     longFired;
  bool     suppress;      // part of a two-button hold, no single action on release
};

Btn b1_ = { PIN_BTN_1, false, false, 0, 0, false, false };
Btn b2_ = { PIN_BTN_2, false, false, 0, 0, false, false };
bool comboActive_ = false;
uint32_t comboAtMs_ = 0;
int lastCountdown_ = -1;

void begin() {
  // Nothing on the board pulls these up; the stock 8051 used its own port pull-ups.
  pinMode(PIN_BTN_1, INPUT_PULLUP);
  pinMode(PIN_BTN_2, INPUT_PULLUP);
}

// Returns +1 on a debounced press, -1 on a release, 0 otherwise.
int sample(Btn& b, uint32_t now) {
  const bool raw = digitalRead(b.pin) == LOW;
  if (raw != b.raw) { b.raw = raw; b.rawSinceMs = now; }
  if (b.raw != b.down && now - b.rawSinceMs >= BTN_DEBOUNCE_MS) {
    b.down = b.raw;
    if (b.down) { b.downAtMs = now; b.longFired = false; b.suppress = false; return 1; }
    return -1;
  }
  return 0;
}

void feedback(const char* text) { clockface::showText(text, BTN_FEEDBACK_MS); }

void stepBrightness() {
  uint8_t next = BRIGHTNESS_STEPS[0];
  for (uint8_t s : BRIGHTNESS_STEPS) if (s > g_settings.brightness) { next = s; break; }
  g_settings.brightness = next;
  if (!g_settings.lightOn) g_settings.lightOn = 1;
  settings::markDirty();
  clockface::markColorsDirty();
  char txt[8];
  std::snprintf(txt, sizeof txt, "b%3u", (unsigned)next);   // "b  5", "b 50", "b100"
  feedback(txt);
}

void toggleDisplay() {
  g_settings.lightOn = g_settings.lightOn ? 0 : 1;
  settings::markDirty();
  clockface::markColorsDirty();
}

void cycleEffect() {
  g_settings.effect = (uint8_t)((g_settings.effect + 1) % 3);
  settings::markDirty();
  clockface::settingsChanged();
  const char* names[3] = { "EF 0", "EF 1", "EF 2" };
  feedback(names[g_settings.effect]);
}

void loop() {
  const uint32_t now = millis();
  const int e1 = sample(b1_, now);
  const int e2 = sample(b2_, now);

  if (b1_.down && b2_.down) {
    if (!comboActive_) {
      comboActive_ = true;
      comboAtMs_ = now;
      lastCountdown_ = -1;
      b1_.suppress = b2_.suppress = true;
    }
    const uint32_t held = now - comboAtMs_;
    if (held >= BTN_FACTORY_RESET_MS) {
      Serial.println("Factory reset from the buttons");
      clockface::showText("rSt ", 5000);
      clockface::loop();
      settings::factoryReset();
      delay(500);
      ESP.restart();
    }
    if (held >= BTN_COMBO_SHOW_MS) {
      uint32_t secs = (BTN_FACTORY_RESET_MS - held + 999) / 1000;
      if (secs > 99) secs = 99;
      const int left = (int)secs;
      if (left != lastCountdown_) {
        lastCountdown_ = left;
        char txt[8];
        std::snprintf(txt, sizeof txt, "rS%2u", (unsigned)secs);
        clockface::showText(txt, 1500);
      }
    }
    return;
  }
  if (comboActive_) {
    comboActive_ = false;
    if (lastCountdown_ >= 0) clockface::showText("    ", 100);   // cancel the countdown frame
  }

  // Long presses fire while held; short presses fire on release.
  if (b1_.down && !b1_.longFired && !b1_.suppress && now - b1_.downAtMs >= BTN_LONG_MS) { b1_.longFired = true; toggleDisplay(); }
  if (b2_.down && !b2_.longFired && !b2_.suppress && now - b2_.downAtMs >= BTN_LONG_MS) { b2_.longFired = true; clockface::showIp(); }
  if (e1 < 0 && !b1_.longFired && !b1_.suppress) stepBrightness();
  if (e2 < 0 && !b2_.longFired && !b2_.suppress) cycleEffect();
}

}  // namespace buttons

