// Minimal JSON writer with string escaping.
class Json {
 public:
  explicit Json(String& out) : s_(out) {}
  Json& open(const char* key = nullptr) { sep(); if (key) name(key); s_ += '{'; first_ = true; return *this; }
  Json& close() { s_ += '}'; first_ = false; return *this; }
  Json& arr(const char* key) { sep(); name(key); s_ += '['; first_ = true; return *this; }
  Json& endArr() { s_ += ']'; first_ = false; return *this; }
  Json& item(const char* v) { sep(); quote(v); return *this; }
  Json& str(const char* key, const char* v) { sep(); name(key); quote(v ? v : ""); return *this; }
  Json& str(const char* key, const String& v) { return str(key, v.c_str()); }
  Json& num(const char* key, long v) { sep(); name(key); s_ += String(v); return *this; }
  Json& unum(const char* key, unsigned long v) { sep(); name(key); s_ += String(v); return *this; }
  Json& real(const char* key, float v, unsigned char dp) { sep(); name(key); if (std::isfinite(v)) s_ += String(v, (unsigned int)dp); else s_ += '0'; return *this; }
  Json& boolean(const char* key, bool v) { sep(); name(key); s_ += v ? "true" : "false"; return *this; }
  Json& null(const char* key) { sep(); name(key); s_ += "null"; return *this; }
  Json& hex(const char* key, const uint8_t rgb[3]) { char h[8]; util::toHex(rgb, h); return str(key, h); }

 private:
  void sep() { if (!first_) s_ += ','; first_ = false; }
  void name(const char* k) { quote(k); s_ += ':'; }
  void quote(const char* v) {
    s_ += '"';
    for (const char* p = v; *p; ++p) {
      const unsigned char c = (unsigned char)*p;
      if (c == '"') s_ += "\\\"";
      else if (c == '\\') s_ += "\\\\";
      else if (c == '\n') s_ += "\\n";
      else if (c < 0x20) { char u[8]; std::snprintf(u, sizeof u, "\\u%04x", c); s_ += u; }
      else s_ += (char)c;
    }
    s_ += '"';
  }
  String& s_;
  bool first_ = true;
};

void sendJson(int code, const String& body) {
  server.sendHeader("Cache-Control", "no-store");
  server.sendHeader("X-Content-Type-Options", "nosniff");
  server.send(code, "application/json", body);
}

void sendError(int code, const char* msg) {
  String out;
  Json(out).open().boolean("ok", false).str("error", msg).close();
  sendJson(code, out);
}

String hostOnly(const String& hostHeader) {
  const int colon = hostHeader.indexOf(':');
  return colon < 0 ? hostHeader : hostHeader.substring(0, colon);
}

// DNS-rebinding guard: the Host header must name this device.
bool hostAllowed() {
  String h = hostOnly(server.hostHeader());
  if (h.length() == 0) return false;
  h.toLowerCase();
  String me(g_settings.hostname);
  me.toLowerCase();
  if (h == me || h == me + ".local") return true;
  if (h == WiFi.localIP().toString()) return true;
  if (h == "localhost") return true;
  return false;
}

bool authOk() {
  if (std::strlen(WEB_AUTH_USER) == 0) return true;
  if (server.authenticate(WEB_AUTH_USER, WEB_AUTH_PASS)) return true;
  server.requestAuthentication();
  return false;
}

// Cross-site request forgery guard for state-changing calls.
bool csrfOk() {
  if (!server.hasHeader("X-Requested-With") || server.header("X-Requested-With") != "HU058Clock") return false;
  if (server.hasHeader("Origin")) {
    const String origin = server.header("Origin");
    const String expect = "http://" + server.hostHeader();
    if (origin != expect) return false;
  }
  return true;
}

bool guard(bool stateChanging) {
  if (!hostAllowed()) { sendError(403, "host not allowed"); return false; }
  if (!authOk()) return false;                       // 401 already sent
  if (stateChanging && !csrfOk()) { sendError(403, "cross-site request rejected"); return false; }
  return true;
}

String fmtTm(const std::tm& tm) {
  char b[40];
  strftime(b, sizeof b, "%Y-%m-%d %H:%M:%S %Z", &tm);
  return String(b);
}

// ---- firmware update record (namespace hu058sys, survives a factory reset)
// "in progress" when an upload starts, then the result. A record still "in progress" at boot
// means the clock restarted mid-upload, reported with the reset reason.
enum : uint8_t { OTA_NONE = 0, OTA_RUNNING = 1, OTA_DONE = 2, OTA_FAILED = 3 };
struct OtaRecord {
  uint8_t  state;
  uint32_t bytes;
  char     text[96];
};
OtaRecord ota_;

void saveOta() {
  Preferences p;
  panel::pauseForFlash();
  if (p.begin("hu058sys", false)) {
    p.putBytes("ota", &ota_, sizeof ota_);
    p.end();
  }
  panel::resumeAfterFlash();
}

void setOta(uint8_t state, uint32_t bytes, const char* text) {
  ota_.state = state;
  ota_.bytes = bytes;
  util::copyStr(ota_.text, sizeof ota_.text, text);
  Serial.printf("[ota] %s\n", ota_.text);
  saveOta();
}

bool uploadOk_ = false;
bool uploadRejected_ = false;
String uploadError_;

void handleRoot() {
  if (!guard(false)) return;
  server.sendHeader("Cache-Control", "no-store");
  server.sendHeader("X-Content-Type-Options", "nosniff");
  server.sendHeader("Content-Encoding", "gzip");
  server.send_P(200, "text/html; charset=utf-8", (PGM_P)INDEX_HTML_GZ, INDEX_HTML_GZ_LEN);
}

// The page's poll. Reused buffer: a fresh String per poll for hours fragments the heap.
void handleStatus() {
  if (!guard(false)) return;
  const int64_t buildStart = esp_timer_get_time();
  wifimgr::Stats ws;
  wifimgr::getStats(ws);
  const int64_t nowUs = esp_timer_get_time();
  const bool up = WiFi.isConnected();

  static String out;
  out.remove(0);
  out.reserve(3072);
  Json j(out);
  j.open().boolean("ok", true);
  j.open("status");
  j.str("version", FW_VERSION).unum("uptime_s", (unsigned long)(nowUs / 1000000));

  std::tm now;
  time_t epoch = 0;
  const bool timeOk = timekeeping::localNow(now, &epoch);
  j.boolean("time_valid", timeOk);
  if (timeOk) {
    char b[40];
    strftime(b, sizeof b, "%Y-%m-%d %H:%M:%S", &now);
    j.str("local", b);
    strftime(b, sizeof b, "%z %Z", &now);
    j.str("zone", b);
    j.boolean("dst_now", now.tm_isdst > 0);
  } else {
    j.str("local", "").str("zone", "").boolean("dst_now", false);
  }
  j.str("tz_active", timekeeping::activeTz());

  // ---- NTP, NtpClockMod fields
  const int64_t age = timekeeping::lastSyncAgeUs();
  j.open("ntp").str("server", timekeeping::server()).boolean("synced", timekeeping::everSynced())
      .unum("sync_count", timekeeping::syncCount()).unum("interval_s", timekeeping::syncIntervalS())
      .num("active_slot", (long)timekeeping::activeSlot())
      .str("active_role", timekeeping::activeSlot() == 0 ? "primary" : "fallback")
      .boolean("failover", g_settings.ntpFailover)
      .boolean("healthy", clockface::syncHonest())
      .num("first_sync_ms", timekeeping::firstSyncMs());
  j.boolean("drift_measured", timekeeping::driftSpanS() > 0)
      .real("drift_ppm_err", timekeeping::driftUncertaintyPpm(), 2)
      .real("drift_recent_ppm", timekeeping::driftRecentPpm(), 2)
      .unum("drift_recent_span_s", timekeeping::driftRecentSpanS());
  j.boolean("drift_valid", timekeeping::driftValid())
      .real("drift_ppm", timekeeping::driftPpm(), 2)
      .unum("drift_span_s", timekeeping::driftSpanS())
      .unum("drift_need_s", DRIFT_VALID_SPAN_S);
  if (age >= 0) {
    std::tm tm;
    timekeeping::toLocal(timekeeping::lastSyncEpoch(), tm);
    j.str("last_sync", fmtTm(tm)).num("last_sync_age_s", (long)(age / 1000000));
  } else {
    j.null("last_sync").num("last_sync_age_s", -1);
  }
  j.close();

  // ---- Wi-Fi, NtpClockMod fields
  j.open("wifi").boolean("connected", up).str("ssid", netcfg::ssid()).str("wifi_source", netcfg::source())
      .str("host", g_settings.hostname)
      .unum("connects", ws.connects).unum("disconnects", ws.disconnects)
      .unum("retries", ws.retries).unum("radio_resets", ws.radioResets)
      .num("last_reason", (long)ws.lastReason).str("last_reason_text", wifimgr::reasonName(ws.lastReason))
      .unum("down_s", wifimgr::downSeconds()).unum("retry_ms", wifimgr::retryDelayMs())
      .num("tx_dbm", (long)g_settings.wifiTxDbm)
      .num("tx_dbm_actual", (long)wifimgr::actualTxDbm())
      .boolean("tx_applied", wifimgr::txApplied())
      .num("ps_mode", (long)g_settings.wifiPsMode)
      .num("first_ip_ms", wifimgr::firstIpMs());
  if (up) j.num("rssi", WiFi.RSSI()).str("ip", WiFi.localIP().toString());
  else j.num("rssi", 0).str("ip", "");
  j.close();

  // ---- display
  j.open("display").str("mode", clockface::modeName()).boolean("night_active", clockface::nightActive())
      .num("current_step", clockface::currentStep())
      .unum("current_ma_x10", face::IS_MA[clockface::currentStep()])
      .boolean("scan_ok", panel::timerOk())
      .boolean("save_pending", settings::dirty()).boolean("save_ok", settings::lastSaveOk())
      .close();

  // ---- system
  const esp_partition_t* run = esp_ota_get_running_partition();
  const esp_partition_t* nxt = esp_ota_get_next_update_partition(nullptr);
  j.open("sys").str("reset_reason", resetReasonName(g_resetReason)).num("reset_code", (long)g_resetReason)
      .unum("boot_count", (unsigned long)g_bootCount)
      .unum("heap_free", (unsigned long)ESP.getFreeHeap())
      .unum("heap_largest", (unsigned long)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT))
      .unum("heap_min", (unsigned long)ESP.getMinFreeHeap())
      .unum("isr_per_s", isrPerSec_).unum("loop_max_us", loopMaxUs_).unum("build_us", buildUs_)
      .unum("scan_steps", panel::steps()).unum("isr_early", panel::earlyCount()).unum("isr_late", panel::lateCount())
      .str("slot_running", run ? run->label : "").str("slot_next", nxt ? nxt->label : "")
      .unum("slot_next_kb", nxt ? (unsigned long)(nxt->size / 1024) : 0UL)
      .num("ota_state", ota_.state).str("ota_last", ota_.text)
      .unum("status_served", statusServed_)
      .close();
  j.close();
  j.close();
  ++statusServed_;
  buildUs_ = (uint32_t)(esp_timer_get_time() - buildStart);
  sendJson(200, out);
}

void buildConfig(Json& j) {
  const Settings& s = g_settings;
  j.open("settings");
  j.boolean("on", s.lightOn).num("bri", s.brightness).num("maxi", s.maxCurrent).hex("color", s.rgb)
      .boolean("h12", s.twelveHour).boolean("blink", s.blinkColon).boolean("lz", s.leadingZero)
      .num("colon", s.colonStatus).num("cmode", s.colorMode);
  j.arr("digits");
  for (int i = 0; i < 4; ++i) { char h[8]; util::toHex(s.digitRgb[i], h); j.item(h); }
  j.endArr();
  j.hex("ga", s.gradA).hex("gb", s.gradB).num("gang", s.gradAngle);
  j.arr("leds");
  for (int i = 0; i < 33; ++i) { char h[8]; util::toHex(s.ledRgb[i], h); j.item(h); }
  j.endArr();
  j.num("fx", s.effect).num("spread", s.spread).num("fxang", s.effectAngle).num("hue", s.hueSpan)
      .real("speed", s.effectSpeedDs / 10.0f, 1).real("fade", s.flashFadeCs / 100.0f, 2)
      .num("dateevery", s.dateEveryS).num("dateshow", s.dateShowMs).num("datefmt", s.dateFormat)
      .boolean("night", s.nightEnabled).num("nstart", s.nightStartMin).num("nend", s.nightEndMin)
      .num("nbri", s.nightBrightness);
  j.str("host", s.hostname);
  j.str("ntp1", s.ntpServer).str("ntp2", s.ntpServer2).str("ntp3", s.ntpServer3)
      .boolean("failover", s.ntpFailover).unum("interval", s.syncIntervalS)
      .str("tz", s.tz).num("dst", s.dstMode).num("tx", s.wifiTxDbm).num("ps", s.wifiPsMode);
  j.close();
}

// Settings for the form: fetched once at page load, and returned by every change.
void handleConfig() {
  if (!guard(false)) return;
  String out;
  out.reserve(3072);
  Json j(out);
  j.open().boolean("ok", true);
  buildConfig(j);
  j.close();
  sendJson(200, out);
}

// Validate every supplied field into a copy, then apply all or nothing. Time and radio changes
// are saved at once (NtpClockMod); display changes are saved 5 s after the last one.
void handleSettings() {
  if (!guard(true)) return;
  Settings n = g_settings;
  const char* err = nullptr;
  long v = 0;
  bool b = false;
  bool display = false;

  auto has = [](const char* k) { return server.hasArg(k); };
  auto arg = [](const char* k) { return server.arg(k); };
  auto boolArg = [&](const char* k, uint8_t& dst, const char* msg) {
    if (err || !has(k)) return;
    if (!util::parseBool(arg(k).c_str(), b)) { err = msg; return; }
    dst = b ? 1 : 0;
    display = true;
  };
  auto intArg = [&](const char* k, long lo, long hi, const char* msg, long& dst) -> bool {
    if (err || !has(k)) return false;
    if (!util::parseLong(arg(k).c_str(), lo, hi, dst)) { err = msg; return false; }
    return true;
  };
  auto colorArg = [&](const char* k, uint8_t dst[3], const char* msg) {
    if (err || !has(k)) return;
    if (!util::parseHex(arg(k).c_str(), dst)) err = msg;
    display = true;
  };

  boolArg("on", n.lightOn, "on: 0 or 1");
  if (intArg("bri", 1, 100, "Brightness: 1 to 100", v)) { n.brightness = (uint8_t)v; display = true; }
  if (intArg("maxi", 0, 15, "Max current: 0 to 15", v)) { n.maxCurrent = (uint8_t)v; display = true; }
  colorArg("color", n.rgb, "Colour: #RRGGBB");
  boolArg("h12", n.twelveHour, "Time format: 0 = 24 hour, 1 = 12 hour");
  boolArg("blink", n.blinkColon, "Blink colon: 0 or 1");
  boolArg("lz", n.leadingZero, "Leading zero: 0 or 1");
  if (intArg("colon", 0, 1, "Colon: 0 both dots blink, 1 upper dot shows sync status", v)) { n.colonStatus = (uint8_t)v; display = true; }
  if (intArg("cmode", 0, 3, "Colour mode: 0 to 3", v)) { n.colorMode = (uint8_t)v; display = true; }
  colorArg("d0", n.digitRgb[0], "Digit 1 colour: #RRGGBB");
  colorArg("d1", n.digitRgb[1], "Digit 2 colour: #RRGGBB");
  colorArg("d2", n.digitRgb[2], "Digit 3 colour: #RRGGBB");
  colorArg("d3", n.digitRgb[3], "Digit 4 colour: #RRGGBB");
  colorArg("ga", n.gradA, "Gradient start: #RRGGBB");
  colorArg("gb", n.gradB, "Gradient end: #RRGGBB");
  if (intArg("gang", -180, 180, "Gradient angle: -180 to 180", v)) { n.gradAngle = (int16_t)v; display = true; }
  if (!err && has("leds")) {
    const String l = arg("leds");
    if (l.length() != 33 * 6) err = "leds: 33 colours of 6 hex digits";
    for (int i = 0; i < 33 && !err; ++i) {
      char h[7];
      std::memcpy(h, l.c_str() + i * 6, 6);
      h[6] = '\0';
      if (!util::parseHex(h, n.ledRgb[i])) err = "leds: invalid hex colour";
    }
    display = true;
  }
  if (intArg("fx", 0, 2, "Effect: 0 to 2", v)) { n.effect = (uint8_t)v; display = true; }
  if (intArg("spread", 0, 2, "Spread: 0 to 2", v)) { n.spread = (uint8_t)v; display = true; }
  if (intArg("fxang", -180, 180, "Effect angle: -180 to 180", v)) { n.effectAngle = (int16_t)v; display = true; }
  if (intArg("hue", 0, 360, "Hue span: 0 to 360", v)) { n.hueSpan = (uint16_t)v; display = true; }
  if (!err && has("speed")) {
    if (util::parseScaled(arg("speed").c_str(), 10, 2, 6000, v)) { n.effectSpeedDs = (uint16_t)v; display = true; }
    else err = "Effect speed: 0.2 to 600 seconds";
  }
  if (!err && has("fade")) {
    if (util::parseScaled(arg("fade").c_str(), 100, 0, 3000, v)) { n.flashFadeCs = (uint16_t)v; display = true; }
    else err = "Flash fade: 0 to 30 seconds";
  }
  if (intArg("dateevery", 0, 3600, "Date every: 0 or 10 to 3600 seconds", v)) {
    if (v != 0 && v < 10) err = "Date every: 0 or 10 to 3600 seconds";
    else { n.dateEveryS = (uint16_t)v; display = true; }
  }
  if (intArg("dateshow", 500, 10000, "Date shown for: 500 to 10000 ms", v)) { n.dateShowMs = (uint16_t)v; display = true; }
  if (intArg("datefmt", 0, 1, "Date format: 0 or 1", v)) { n.dateFormat = (uint8_t)v; display = true; }
  boolArg("night", n.nightEnabled, "Night mode: 0 or 1");
  if (intArg("nstart", 0, 1439, "Night start: 0 to 1439 minutes", v)) { n.nightStartMin = (uint16_t)v; display = true; }
  if (intArg("nend", 0, 1439, "Night end: 0 to 1439 minutes", v)) { n.nightEndMin = (uint16_t)v; display = true; }
  if (intArg("nbri", 0, 100, "Night brightness: 0 to 100", v)) { n.nightBrightness = (uint8_t)v; display = true; }

  // ---- time and radio (NtpClockMod rules)
  if (!err && has("ntp1")) {
    String s = arg("ntp1"); s.trim();
    if (!settings::validNtpServer(s.c_str())) err = "NTP server: hostname or IPv4 address (letters, digits, dots, hyphens; max 63)";
    else util::copyStr(n.ntpServer, sizeof n.ntpServer, s.c_str());
  }
  if (!err && has("ntp2")) {
    String s = arg("ntp2"); s.trim();
    if (s.length() && !settings::validNtpServer(s.c_str())) err = "NTP fallback 1: hostname or IPv4 address, or empty to disable";
    else util::copyStr(n.ntpServer2, sizeof n.ntpServer2, s.c_str());
  }
  if (!err && has("ntp3")) {
    String s = arg("ntp3"); s.trim();
    if (s.length() && !settings::validNtpServer(s.c_str())) err = "NTP fallback 2: hostname or IPv4 address, or empty to disable";
    else util::copyStr(n.ntpServer3, sizeof n.ntpServer3, s.c_str());
  }
  if (!err && has("failover")) {
    if (!util::parseBool(arg("failover").c_str(), b)) err = "Failover: 0 or 1";
    else n.ntpFailover = b;
  }
  if (!err && has("host")) {
    String h = arg("host"); h.trim(); h.toLowerCase();
    if (!settings::validHostname(h.c_str())) err = "Hostname: 1 to 32 of a-z, 0-9 and -, not starting or ending with -";
    else util::copyStr(n.hostname, sizeof n.hostname, h.c_str());
  }
  if (!err && has("tz")) {
    String s = arg("tz"); s.trim();
    if (!settings::validTz(s.c_str())) err = "Time zone: POSIX TZ rule, for example EST5EDT,M3.2.0,M11.1.0";
    else util::copyStr(n.tz, sizeof n.tz, s.c_str());
  }
  if (intArg("interval", (long)NTP_MIN_INTERVAL_S, (long)NTP_MAX_INTERVAL_S, "Poll interval: 15 to 86400 seconds", v))
    n.syncIntervalS = (uint32_t)v;
  if (intArg("dst", 0, 2, "Daylight saving: 0 auto, 1 standard all year, 2 daylight all year", v)) n.dstMode = (uint8_t)v;
  if (intArg("tx", 2, 20, "Wi-Fi TX power: 2 to 20 dBm", v)) n.wifiTxDbm = settings::quantiseTxDbm((int)v);
  if (intArg("ps", 0, 2, "Wi-Fi sleep mode: 0, 1 or 2", v)) n.wifiPsMode = (uint8_t)v;
  if (err) { sendError(400, err); return; }

  const bool ntpChanged = std::strcmp(n.ntpServer, g_settings.ntpServer) != 0 ||
                          std::strcmp(n.ntpServer2, g_settings.ntpServer2) != 0 ||
                          std::strcmp(n.ntpServer3, g_settings.ntpServer3) != 0;
  const bool foOff = g_settings.ntpFailover && !n.ntpFailover;
  const bool tzChanged = std::strcmp(n.tz, g_settings.tz) != 0 || n.dstMode != g_settings.dstMode;
  const bool ivalChanged = n.syncIntervalS != g_settings.syncIntervalS;
  const bool radioChanged = n.wifiTxDbm != g_settings.wifiTxDbm || n.wifiPsMode != g_settings.wifiPsMode;
  // A new name takes a restart: DHCP, mDNS and the IDE upload port all take it at start-up.
  const bool hostChanged = std::strcmp(n.hostname, g_settings.hostname) != 0;
  const bool timeOrRadio = ntpChanged || foOff || n.ntpFailover != g_settings.ntpFailover || tzChanged || ivalChanged || radioChanged || hostChanged;
  char oldHost[sizeof g_settings.hostname];
  util::copyStr(oldHost, sizeof oldHost, g_settings.hostname);

  g_settings = n;
  // Turning failover off while parked on a fallback must not strand the device there.
  if (foOff && timekeeping::activeSlot() != 0) timekeeping::selectSlot(0);
  // Applied in place, no reconnect: dropping TX power must not drop the link answering this.
  if (radioChanged) wifimgr::applyRadioPower();
  if (tzChanged) {
    char active[64];
    settings::effectiveTz(active, sizeof active);
    timekeeping::setTz(active);
  }
  if (ivalChanged) timekeeping::setSyncInterval(g_settings.syncIntervalS);
  if (ntpChanged) timekeeping::setServer(g_settings.ntpServer);
  if (display) clockface::settingsChanged();

  bool saved = true;
  if (timeOrRadio) saved = settings::save();
  else if (display) settings::markDirty();
  // Restart only once the new name is safely stored; otherwise keep answering to the old one.
  bool restarting = false;
  if (hostChanged) {
    if (saved) {
      restarting = true;
      rebootPending_ = true;
      rebootAtMs_ = millis() + 1500;
    } else {
      util::copyStr(g_settings.hostname, sizeof g_settings.hostname, oldHost);
    }
  }

  String out;
  out.reserve(3072);
  Json j(out);
  j.open().boolean("ok", saved).boolean("restart", restarting);
  if (!saved) j.str("error", "NVS write failed: settings are active until reboot");
  buildConfig(j);
  j.close();
  sendJson(saved ? 200 : 500, out);
}

void handleAction() {
  if (!guard(true)) return;
  const String a = server.arg("a");
  long ms = 5000;
  if (server.hasArg("ms") && !util::parseLong(server.arg("ms").c_str(), (long)TEMP_MODE_MIN_MS, (long)TEMP_MODE_MAX_MS, ms)) {
    sendError(400, "ms: 100 to 600000");
    return;
  }
  if (a == "lamp") {
    clockface::lampTest(server.hasArg("ms") ? ms : 3000);
  } else if (a == "seconds") {
    clockface::showSeconds(ms);
  } else if (a == "date") {
    clockface::showDate(server.hasArg("ms") ? ms : g_settings.dateShowMs);
  } else if (a == "ip") {
    clockface::showIp();
  } else if (a == "number") {
    long value = 0;
    if (!util::parseLong(server.arg("value").c_str(), -999, 9999, value)) { sendError(400, "Number: -999 to 9999"); return; }
    const String unit = server.arg("unit");
    if (unit.length() > 1) { sendError(400, "Unit: one character or empty"); return; }
    clockface::showNumber((int)value, unit.length() ? unit[0] : '\0', ms);
  } else if (a == "text") {
    const String text = server.arg("text");
    if (text.length() > 4 || !util::printable(text.c_str())) { sendError(400, "Text: up to 4 characters"); return; }
    clockface::showText(text.c_str(), ms > 60000 ? 60000 : ms);
  } else if (a == "sync") {
    if (!timekeeping::syncNow()) { sendError(503, "SNTP not running yet"); return; }
  } else if (a == "reboot") {
    if (settings::dirty()) settings::save();
    rebootPending_ = true;
    rebootAtMs_ = millis() + 1000;
  } else if (a == "factory") {
    settings::factoryReset();
    rebootPending_ = true;
    rebootAtMs_ = millis() + 1000;
  } else {
    sendError(400, "Unknown action");
    return;
  }
  String out;
  Json(out).open().boolean("ok", true).close();
  sendJson(200, out);
}

// Lightweight liveness probe (NtpClockMod).
void handlePing() {
  if (!guard(false)) return;
  String out;
  Json(out).open().boolean("ok", true).str("version", FW_VERSION)
      .unum("uptime_s", (unsigned long)(esp_timer_get_time() / 1000000))
      .unum("heap", (unsigned long)ESP.getFreeHeap())
      .unum("status_served", statusServed_).close();
  sendJson(200, out);
}

// Firmware upload: Espressif's WebUpdate example sequence (Update.begin with the slot size,
// write each chunk, Update.end(true)), with the host and CSRF checks above and a record of
// every attempt. The display scan is stopped and the panel dark for the whole write.
void handleUploadChunk() {
  HTTPUpload& up = server.upload();
  char t[96];
  if (up.status == UPLOAD_FILE_START) {
    uploadOk_ = false;
    uploadError_ = "";
    uploadRejected_ = !hostAllowed() || (std::strlen(WEB_AUTH_USER) && !server.authenticate(WEB_AUTH_USER, WEB_AUTH_PASS)) || !csrfOk();
    if (uploadRejected_) { uploadError_ = "upload not authorised"; Serial.println("[ota] upload rejected: not authorised"); return; }
    const esp_partition_t* next = esp_ota_get_next_update_partition(nullptr);
    if (!next) {
      uploadError_ = "No update slot: flashed with a partition scheme without OTA. Flash once over USB with Default 4MB with spiffs.";
      uploadRejected_ = true;
      setOta(OTA_FAILED, 0, "Failed: no update slot in the partition table");
      return;
    }
    if (Update.isRunning()) Update.abort();
    clockface::setBlank(true);
    panel::pauseForFlash();                          // held until the upload ends or fails
    std::snprintf(t, sizeof t, "Started: %s into %s (%lu KB slot)", up.filename.c_str(), next->label, (unsigned long)(next->size / 1024));
    setOta(OTA_RUNNING, 0, t);
    if (!Update.begin(UPDATE_SIZE_UNKNOWN, U_FLASH)) {
      uploadError_ = Update.errorString();
      uploadRejected_ = true;
      panel::resumeAfterFlash();
      clockface::setBlank(false);
      std::snprintf(t, sizeof t, "Failed to start: %s", uploadError_.c_str());
      setOta(OTA_FAILED, 0, t);
    }
  } else if (up.status == UPLOAD_FILE_WRITE) {
    if (uploadRejected_) return;
    const uint32_t before = up.totalSize;
    if (Update.write(up.buf, up.currentSize) != up.currentSize) {
      uploadError_ = Update.errorString();
      uploadRejected_ = true;
      Update.abort();
      panel::resumeAfterFlash();
      clockface::setBlank(false);
      std::snprintf(t, sizeof t, "Failed writing at %lu KB: %s", (unsigned long)(before / 1024), uploadError_.c_str());
      setOta(OTA_FAILED, before, t);
      return;
    }
    if ((before + up.currentSize) / 131072 != before / 131072)
      Serial.printf("[ota] %lu KB received\n", (unsigned long)((before + up.currentSize) / 1024));
  } else if (up.status == UPLOAD_FILE_END) {
    if (uploadRejected_) return;
    if (Update.end(true)) {
      uploadOk_ = true;
      std::snprintf(t, sizeof t, "Succeeded: %lu KB written, replacing %s", (unsigned long)(up.totalSize / 1024), FW_VERSION);
      setOta(OTA_DONE, up.totalSize, t);
    } else {
      uploadError_ = Update.errorString();
      panel::resumeAfterFlash();
      clockface::setBlank(false);
      std::snprintf(t, sizeof t, "Failed at the end (%lu KB): %s", (unsigned long)(up.totalSize / 1024), uploadError_.c_str());
      setOta(OTA_FAILED, up.totalSize, t);
    }
  } else if (up.status == UPLOAD_FILE_ABORTED) {
    // The web server closes the connection without an answer after this, so the browser only
    // sees a network error: the record is how the reason reaches the page.
    const uint32_t got = up.totalSize + up.currentSize;
    if (!uploadRejected_) {
      Update.abort();
      std::snprintf(t, sizeof t, "Failed: connection lost or stalled 5 s after %lu KB", (unsigned long)(got / 1024));
      setOta(OTA_FAILED, got, t);
    }
    uploadRejected_ = true;
    uploadError_ = "upload aborted";
    panel::resumeAfterFlash();
    clockface::setBlank(false);
  }
}

void handleUploadDone() {
  if (!hostAllowed()) { sendError(403, "host not allowed"); return; }
  if (std::strlen(WEB_AUTH_USER) && !server.authenticate(WEB_AUTH_USER, WEB_AUTH_PASS)) { server.requestAuthentication(); return; }
  if (!uploadOk_) { sendError(400, uploadError_.length() ? uploadError_.c_str() : "no firmware received"); return; }
  if (settings::dirty()) settings::save();
  String out;
  Json(out).open().boolean("ok", true).str("message", "Firmware written, restarting").close();
  server.sendHeader("Connection", "close");
  sendJson(200, out);
  rebootPending_ = true;
  rebootAtMs_ = millis() + 1000;
}

}  // namespace impl

// At boot: load the last update record and resolve one that never finished.
void loadOta() {
  std::memset(&impl::ota_, 0, sizeof impl::ota_);
  Preferences p;
  if (p.begin("hu058sys", true)) {
    if (p.getBytesLength("ota") == sizeof impl::ota_) p.getBytes("ota", &impl::ota_, sizeof impl::ota_);
    p.end();
  }
  impl::ota_.text[sizeof impl::ota_.text - 1] = '\0';
  if (impl::ota_.state == impl::OTA_RUNNING) {
    char t[96];
    std::snprintf(t, sizeof t, "Failed: the clock restarted during the upload (reset reason: %s)",
                  resetReasonName(g_resetReason));
    impl::setOta(impl::OTA_FAILED, 0, t);
  }
}

void begin() {
  impl::server.collectHeaders(impl::COLLECT_HEADERS, sizeof impl::COLLECT_HEADERS / sizeof impl::COLLECT_HEADERS[0]);
  impl::server.on("/", HTTP_GET, impl::handleRoot);
  impl::server.on("/api/status", HTTP_GET, impl::handleStatus);
  impl::server.on("/api/config", HTTP_GET, impl::handleConfig);
  impl::server.on("/api/ping", HTTP_GET, impl::handlePing);
  impl::server.on("/api/settings", HTTP_POST, impl::handleSettings);
  impl::server.on("/api/action", HTTP_POST, impl::handleAction);
  impl::server.on("/api/update", HTTP_POST, impl::handleUploadDone, impl::handleUploadChunk);
  impl::server.onNotFound([] { impl::sendError(404, "not found"); });
  impl::server.begin();
}

void loop() {
  impl::server.handleClient();
  if (impl::rebootPending_ && (int32_t)(millis() - impl::rebootAtMs_) >= 0) {
    Serial.println("Restarting");
    delay(100);
    ESP.restart();
  }
}

uint32_t statusServed() { return impl::statusServed_; }

void setLoad(uint32_t isrPerSec, uint32_t loopMaxUs) {
  impl::isrPerSec_ = isrPerSec;
  impl::loopMaxUs_ = loopMaxUs;
}

}  // namespace webui

// ============================================================================ SETUP / LOOP

namespace {

// Strict primary with failover, replacing both the old kick-when-quiet watchdog and lwIP's
// round-robin. Exactly one server is installed at a time, so this is the whole selection
// policy. Silence is judged on the global last-sync age, which is sound here precisely because
// only one server is ever installed: any sync in the window came from the active one.
void ntpPolicy() {
  // Cheapest possible test first, ahead of anything that locks. See NTP_POLICY_PERIOD_MS.
  const uint32_t now = millis();
  static uint32_t lastCheckMs = 0;
  if (now - lastCheckMs < NTP_POLICY_PERIOD_MS) return;
  lastCheckMs = now;

  if (!WiFi.isConnected()) return;                 // a dead link is not the server's fault

  uint32_t windowS = timekeeping::syncIntervalS() * NTP_FAILOVER_AFTER_MULT;
  if (windowS < NTP_FAILOVER_MIN_S) windowS = NTP_FAILOVER_MIN_S;

  const uint32_t sinceSwitch = now - timekeeping::slotSinceMs();
  const uint8_t  slot = timekeeping::activeSlot();

  // Has the CURRENT server answered at all? selectSlot restarts SNTP, which sends a request
  // immediately, so a reachable server answers within seconds. Counting syncs since the switch
  // is unambiguous where the global age is not: the age may still be small because the
  // PREVIOUS server answered a moment before the switch.
  const bool answered = timekeeping::syncCount() > timekeeping::slotSyncCount();

  if (!answered) {
    if (sinceSwitch < NTP_PROBE_S * 1000UL) return;            // still inside its grace period
    const uint8_t next = timekeeping::nextUsableSlot(slot);
    Serial.printf("[ntp] %s did not answer in %lus, %s\n", timekeeping::server(),
                  (unsigned long)NTP_PROBE_S,
                  next == slot ? "restarting the request" : "trying the next server");
    timekeeping::selectSlot(next);
    return;
  }

  const int64_t age = timekeeping::lastSyncAgeUs();
  const bool healthy = age >= 0 && age <= (int64_t)windowS * 1000000LL;

  if (healthy) {
    // On a fallback and the primary has had long enough to recover: give it the slot back. If
    // it is still down this costs one poll and the next pass demotes again.
    if (slot != 0 && g_settings.ntpFailover &&
        sinceSwitch >= NTP_RETURN_PRIMARY_S * 1000UL) {
      Serial.println("[ntp] returning to the primary server");
      timekeeping::selectSlot(0);
    }
    return;
  }

  const uint8_t next = timekeeping::nextUsableSlot(slot);
  Serial.printf("[ntp] %s silent for %lus, %s\n", timekeeping::server(),
                (unsigned long)windowS,
                next == slot ? "restarting the request" : "failing over");
  timekeeping::selectSlot(next);
}

}  // namespace

void setup() {
#if ARDUINO_USB_CDC_ON_BOOT
  Serial.setTxTimeoutMs(0);                         // never stall when no USB host is reading
#endif
  Serial.begin(115200);
  panel::begin();                                   // blank the drivers before anything else runs
  Serial.println();
  Serial.println("HU058NtpClock " FW_VERSION " starting");
  g_resetReason = esp_reset_reason();
  {
    // Boot counter in its own namespace, so a factory reset does not clear it.
    Preferences p;
    panel::pauseForFlash();
    if (p.begin("hu058sys", false)) {
      g_bootCount = p.getULong("boots", 0) + 1;
      p.putULong("boots", g_bootCount);
      p.end();
    }
    panel::resumeAfterFlash();
  }
  Serial.printf("Last reset: %s (code %d) | boot #%lu\n",
                resetReasonName(g_resetReason), (int)g_resetReason, (unsigned long)g_bootCount);

  webui::loadOta();
  settings::load();
  // Pin the name in NVS on the first boot of a build that stores it, so a later build with a
  // different DEVICE_HOSTNAME default can never rename this clock.
  if (!settings::hostStored()) settings::save();
  Serial.printf("Hostname %s\n", g_settings.hostname);
  netcfg::begin();
  char activeTz[64];
  settings::effectiveTz(activeTz, sizeof activeTz);
  Serial.printf("NTP %s every %lu s | TZ %s -> %s\n", g_settings.ntpServer,
                (unsigned long)g_settings.syncIntervalS, g_settings.tz, activeTz);

  face::initDutyTable();                            // colour lookup table, replaces powf per frame
  timekeeping::begin(g_settings.ntpServer, activeTz, g_settings.syncIntervalS);
  clockface::settingsChanged();
  buttons::begin();
  wifimgr::begin();
  webui::begin();
}

void loop() {
  const uint32_t passStart = micros();
  wifimgr::loop();

  if (wifimgr::takeGotIp()) {
    // Re-anchor on the primary: a reconnect is a new network situation, and whatever drove
    // the device onto a fallback may well have been the link itself.
    timekeeping::selectSlot(0);             // immediate NTP request on every (re)connect
    services::onGotIp();
    netcfg::rememberIfNew();
    Serial.printf("Wi-Fi up: http://%s/  (http://%s.local/)\n",
                  WiFi.localIP().toString().c_str(), g_settings.hostname);
  }

  ntpPolicy();
  services::loop();
  buttons::loop();
  clockface::loop();
  webui::loop();
  settings::loop();

  // Load figures for the System tab: interrupts per second, and the longest single pass of this
  // loop over the last 10 s.
  const uint32_t pass = micros() - passStart;
  static uint32_t windowMax = 0, windowStartMs = 0, lastIsr = 0, lastIsrMs = 0, loopMax = 0, isrRate = 0;
  if (pass > windowMax) windowMax = pass;
  const uint32_t nowMs = millis();
  if (nowMs - lastIsrMs >= 1000) {
    const uint32_t c = panel::isrCount();
    isrRate = (uint32_t)((uint64_t)(c - lastIsr) * 1000ULL / (nowMs - lastIsrMs));
    lastIsr = c;
    lastIsrMs = nowMs;
    webui::setLoad(isrRate, loopMax);
  }
  if (nowMs - windowStartMs >= 10000) {
    loopMax = windowMax;
    windowMax = 0;
    windowStartMs = nowMs;
  }

  // Heartbeat: a repeating startup banner with "up" resetting means the ESP32 is rebooting;
  // "served" stuck at 0 while the web page is open means the status handler is faulting.
  static uint32_t hbMs = 0;
  if (nowMs - hbMs >= 5000) {
    hbMs = nowMs;
    Serial.printf("[hb] up %lus heap %u largest %u min %u wifi %s served %lu isr %lu/s steps %u early %lu late %lu loop max %lu us\n",
                  (unsigned long)(nowMs / 1000), (unsigned)ESP.getFreeHeap(),
                  (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_8BIT),
                  (unsigned)ESP.getMinFreeHeap(),
                  WiFi.isConnected() ? "up" : "down", (unsigned long)webui::statusServed(),
                  (unsigned long)isrRate, (unsigned)panel::steps(), (unsigned long)panel::earlyCount(),
                  (unsigned long)panel::lateCount(), (unsigned long)loopMax);
  }
  delay(2);
}
