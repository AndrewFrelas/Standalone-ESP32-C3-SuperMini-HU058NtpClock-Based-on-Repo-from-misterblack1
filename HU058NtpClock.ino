constexpr float PANEL_GAMMA = 2.8f;
constexpr uint8_t COLOR_BITS = 4;
constexpr uint8_t COLOR_LEVELS = 1 << COLOR_BITS;   // duty levels 0..15

float clampf(float v, float lo, float hi) { return v < lo ? lo : (v > hi ? hi : v); }

// Brightness 0..1 -> current step. Perceived output is interpolated between the 2.5 mA floor and
// full, so all sixteen steps are spread across the slider instead of a third of it sitting on
// the floor.
uint8_t currentFor(float brightness) {
  const float pMin = powf((float)IS_MA[0] / (float)IS_MA[15], 1.0f / PANEL_GAMMA);
  const float p = pMin + clampf(brightness, 0.0f, 1.0f) * (1.0f - pMin);
  const float want = powf(p, PANEL_GAMMA) * (float)IS_MA[15];
  uint8_t best = 0;
  for (uint8_t i = 1; i < 16; ++i)
    if (fabsf((float)IS_MA[i] - want) < fabsf((float)IS_MA[best] - want)) best = i;
  return best;
}

// Colour component 0..1 -> duty level 0..15, linearised before rounding so pastels survive.
// Reference definition; only used at boot to build the threshold table below.
uint8_t dutyLevelRef(float c) {
  return (uint8_t)lroundf(powf(clampf(c, 0.0f, 1.0f), PANEL_GAMMA) * (float)(COLOR_LEVELS - 1));
}

// The C3 has no floating-point unit, so powf runs in software and an effect calls this about a
// hundred times per frame. The reference is monotonic, so it is fully described by the smallest
// input reaching each level. Those are found once at boot by bisection over the float bit
// patterns (positive floats order like their bits), and the result is identical for every input.
float dutyThreshold_[COLOR_LEVELS];                // [k] = smallest c with dutyLevelRef(c) >= k
bool  dutyReady_ = false;

void initDutyTable() {
  for (uint8_t k = 1; k < COLOR_LEVELS; ++k) {
    uint32_t lo = 0, hi = 0x3F800000u;             // 0.0f .. 1.0f
    while (lo < hi) {
      const uint32_t mid = lo + (hi - lo) / 2;
      float f;
      std::memcpy(&f, &mid, sizeof f);
      if (dutyLevelRef(f) >= k) hi = mid; else lo = mid + 1;
    }
    std::memcpy(&dutyThreshold_[k], &lo, sizeof lo);
  }
  dutyThreshold_[0] = 0.0f;
  dutyReady_ = true;
}

uint8_t dutyLevel(float c) {
  if (!dutyReady_) return dutyLevelRef(c);
  c = clampf(c, 0.0f, 1.0f);
  uint8_t k = 0;
  while (k + 1 < COLOR_LEVELS && c >= dutyThreshold_[k + 1]) ++k;
  return k;
}

// Full saturation hue (0..1, wraps) to RGB 0..1.
void hueRgb(float h, float out[3]) {
  h -= floorf(h);
  const float x = h * 6.0f;
  const int i = (int)x;
  const float f = x - (float)i;
  switch (i % 6) {
    case 0:  out[0] = 1.0f;     out[1] = f;        out[2] = 0.0f;     break;
    case 1:  out[0] = 1.0f - f; out[1] = 1.0f;     out[2] = 0.0f;     break;
    case 2:  out[0] = 0.0f;     out[1] = 1.0f;     out[2] = f;        break;
    case 3:  out[0] = 0.0f;     out[1] = 1.0f - f; out[2] = 1.0f;     break;
    case 4:  out[0] = f;        out[1] = 0.0f;     out[2] = 1.0f;     break;
    default: out[0] = 1.0f;     out[1] = 0.0f;     out[2] = 1.0f - f; break;
  }
}

// Projection of every LED onto an axis at `angleDeg` (0 = left to right, 90 = top to bottom),
// normalised against the LEDs themselves so both ends of a ramp land on real LEDs.
// perLed[blk][seg] is 0..1; perBlock[blk] is each digit's mean, normalised end to end.
void projectAxis(float angleDeg, float perLed[4][9], float perBlock[4]) {
  const float a = angleDeg * 3.14159265f / 180.0f;
  const float ca = cosf(a), sa = sinf(a);
  float lo = 1e9f, hi = -1e9f;
  for (int b = 0; b < 4; ++b)
    for (int s = 0; s < 9; ++s) {
      if (!GEOM[b][s].id) continue;
      const float t = (GEOM[b][s].nx / 255.0f) * ca + (GEOM[b][s].ny / 255.0f) * sa;
      if (t < lo) lo = t;
      if (t > hi) hi = t;
    }
  float span = hi - lo;
  if (span < 1e-6f) span = 1.0f;
  float blo = 1e9f, bhi = -1e9f;
  for (int b = 0; b < 4; ++b) {
    float sum = 0.0f;
    int n = 0;
    for (int s = 0; s < 9; ++s) {
      perLed[b][s] = 0.0f;
      if (!GEOM[b][s].id) continue;
      const float t = ((GEOM[b][s].nx / 255.0f) * ca + (GEOM[b][s].ny / 255.0f) * sa - lo) / span;
      perLed[b][s] = clampf(t, 0.0f, 1.0f);
      sum += perLed[b][s];
      ++n;
    }
    perBlock[b] = n ? sum / (float)n : 0.0f;
    if (perBlock[b] < blo) blo = perBlock[b];
    if (perBlock[b] > bhi) bhi = perBlock[b];
  }
  float bspan = bhi - blo;
  if (bspan < 1e-6f) bspan = 1.0f;
  for (int b = 0; b < 4; ++b) perBlock[b] = (perBlock[b] - blo) / bspan;
}

}  // namespace face

// ============================================================================ PANEL DRIVER (AiP33628 x2)

namespace panel {

// Scan: four COM pairs per driver, each 600 us, split into binary weighted sub-frames of 40, 80,
// 160 and 320 us. A channel at duty level L is lit in sub-frame k when bit k of L is set, so
// four sub-frames give sixteen levels. Full cycle 2400 us, 416.7 Hz. Identical neighbouring
// sub-frames merge, so a saturated colour costs one frame per COM pair.
//
// One timer interrupt per scan step: the counter runs free and each interrupt moves the alarm on
// by that step's dwell (Espressif's dynamic alarm pattern, no auto-reload). On the single-core
// C3 a fixed 40 us tick costs 25,000 interrupts a second whatever is shown; per step it is
// 1,667 a second for solid colours and 6,667 at most.
constexpr uint32_t UNIT_US = 40;
constexpr uint8_t  MAX_STEPS = 4 * face::COLOR_BITS;
const uint8_t COM_SEQ[4] = { 0x30, 0x0C, 0x03, 0xC0 };   // stock scan order

// Current step to the nibble on the wire: IS[0] travels at bit 27 and IS[3] at bit 24, so the
// field is bit reversed against the rest of the frame. Self-inverse.
DRAM_ATTR const uint8_t IS_WIRE[16] = { 0x0, 0x8, 0x4, 0xC, 0x2, 0xA, 0x6, 0xE,
                                        0x1, 0x9, 0x5, 0xD, 0x3, 0xB, 0x7, 0xF };

constexpr uint32_t M_CLK    = 1UL << PIN_CLK;
constexpr uint32_t M_DATA   = 1UL << PIN_DATA;
constexpr uint32_t M_CLK_1  = 1UL << PIN_CLK_1;
constexpr uint32_t M_DATA_1 = 1UL << PIN_DATA_1;

struct ScanStep {
  uint8_t  units;   // dwell in UNIT_US ticks, 1..15
  uint8_t  cs;
  uint16_t ss[2];
};

struct ScanBuf {
  ScanStep step[MAX_STEPS];
  uint8_t  n;
  uint8_t  is;
};

// Written by the loop task, read by the ISR. render() fills the back buffer and flips front_.
ScanBuf buf_[2];
volatile uint8_t front_ = 0;
volatile uint8_t step_ = 0;
volatile uint32_t isrCount_ = 0;                   // scan steps latched, for the interrupts-per-second figure
volatile uint32_t earlyCount_ = 0;                 // alarms that fired before their time
volatile uint32_t lateCount_ = 0;                  // alarms serviced after the next one was already due
bool timerOk_ = false;
gptimer_handle_t timer_ = nullptr;
uint8_t pauseDepth_ = 0;                           // nested pauseForFlash calls, loop task only

static inline void IRAM_ATTR edgeDelay() {
  for (int i = 0; i < BUS_EDGE_NOPS; ++i) __asm__ __volatile__("nop");
}

// One 30-bit frame to each driver, both buses clocked together, then latched. LSB first:
// SS[15:0], CS[7:0], IS[3:0], two reserved zeros. Data changes only while CLK is low. The latch
// is a DATA rising edge while CLK is held high after bit 29.
void IRAM_ATTR sendPair(uint16_t ss1, uint16_t ss2, uint8_t cs, uint8_t is) {
  const uint32_t wire = (uint32_t)IS_WIRE[is & 0xF] << 24;
  uint32_t f1 = (uint32_t)ss1 | ((uint32_t)cs << 16) | wire;
  uint32_t f2 = (uint32_t)ss2 | ((uint32_t)cs << 16) | wire;
  const uint32_t clks = M_CLK | M_CLK_1;
  const uint32_t dats = M_DATA | M_DATA_1;

  REG_WRITE(GPIO_OUT_W1TC_REG, clks | dats);
  edgeDelay();
  for (int i = 0; i < 30; ++i) {
    uint32_t set = 0;
    if (f1 & 1u) set |= M_DATA;
    if (f2 & 1u) set |= M_DATA_1;
    f1 >>= 1;
    f2 >>= 1;
    REG_WRITE(GPIO_OUT_W1TC_REG, dats & ~set);
    REG_WRITE(GPIO_OUT_W1TS_REG, set);
    edgeDelay();
    REG_WRITE(GPIO_OUT_W1TS_REG, clks);              // rising edge shifts both buses
    edgeDelay();
    if (i < 29) {
      REG_WRITE(GPIO_OUT_W1TC_REG, clks);
      edgeDelay();
    }
  }
  REG_WRITE(GPIO_OUT_W1TC_REG, dats);
  edgeDelay();
  REG_WRITE(GPIO_OUT_W1TS_REG, dats);                // DATA rising while CLK high: latch
  edgeDelay();
  REG_WRITE(GPIO_OUT_W1TC_REG, dats);
  edgeDelay();
  REG_WRITE(GPIO_OUT_W1TC_REG, clks);
}

// Latch the next step, then move the alarm on by that step's dwell from the alarm that fired, so
// timing does not accumulate interrupt latency. If this interrupt ran so late that the next
// alarm would already be due (interrupts are held off while flash is written), the dwell is
// counted from now instead: one long step, never a burst of catch-up interrupts.
// A genuine alarm always finds the counter at or past its alarm value. One that does not fired
// early: it is re-armed for the same value and the step is not advanced, so it can neither cut a
// sub-frame short nor skew the colour weighting.
bool IRAM_ATTR scanTick(gptimer_handle_t timer, const gptimer_alarm_event_data_t* ev, void*) {
  if (ev->count_value < ev->alarm_value) {
    earlyCount_ = earlyCount_ + 1;
    gptimer_alarm_config_t again = {};
    again.alarm_count = ev->alarm_value;
    gptimer_set_alarm_action(timer, &again);
    return false;
  }
  isrCount_ = isrCount_ + 1;
  const ScanBuf& b = buf_[front_];
  uint32_t units = 15;                             // empty schedule: idle one COM slot
  if (b.n > 0) {
    uint8_t i = step_;
    if (i >= b.n) i = 0;                           // schedule may have shrunk at a flip
    const ScanStep& st = b.step[i];
    sendPair(st.ss[0], st.ss[1], st.cs, b.is);
    units = st.units;
    const uint8_t next = (uint8_t)(i + 1);
    step_ = next >= b.n ? 0 : next;
  }
  const uint64_t dwell = (uint64_t)units * UNIT_US;
  uint64_t now = ev->count_value;
  gptimer_get_raw_count(timer, &now);
  gptimer_alarm_config_t a = {};
  a.alarm_count = ev->alarm_value + dwell;
  if (a.alarm_count < now + UNIT_US / 2) {
    a.alarm_count = now + dwell;
    lateCount_ = lateCount_ + 1;
  }
  gptimer_set_alarm_action(timer, &a);
  return false;
}

// Panel state, owned by the loop task.
bool    on_[4][9];          // which positions are lit
uint8_t level_[4][9][3];    // duty level per channel, indexed CH_*
uint8_t is_ = 0;            // current step for the next render

// Collapse on_ and level_ into a scan schedule and publish it.
void render() {
  uint16_t sub[2][4][face::COLOR_BITS];
  std::memset(sub, 0, sizeof sub);
  for (int blk = 0; blk < 4; ++blk) {
    const face::Block& b = face::BLOCKS[blk];
    for (int seg = 0; seg < 9; ++seg) {
      if (!on_[blk][seg]) continue;
      const face::SegPos& sp = face::SEGMAP[seg];
      const uint8_t cs = sp.side ? b.comHi : b.comLo;
      int ci = 0;
      for (int k = 0; k < 4; ++k) if (COM_SEQ[k] == cs) ci = k;
      const int base = 3 * sp.led - 2;
      for (int ch = 0; ch < 3; ++ch) {
        const uint8_t lv = level_[blk][seg][ch];
        if (!lv) continue;
        const uint16_t bit = (uint16_t)(1u << (base + ch));
        for (int k = 0; k < face::COLOR_BITS; ++k)
          if (lv & (1u << k)) sub[b.drv][ci][k] |= bit;
      }
    }
  }

  ScanBuf& out = buf_[front_ ^ 1];
  out.n = 0;
  for (int ci = 0; ci < 4; ++ci) {
    for (int k = 0; k < face::COLOR_BITS; ++k) {
      const uint16_t s0 = sub[0][ci][k], s1 = sub[1][ci][k];
      const uint8_t units = (uint8_t)(1u << k);
      if (k > 0 && out.n > 0 && out.step[out.n - 1].ss[0] == s0 && out.step[out.n - 1].ss[1] == s1) {
        out.step[out.n - 1].units = (uint8_t)(out.step[out.n - 1].units + units);
        continue;
      }
      ScanStep& st = out.step[out.n++];
      st.units = units;
      st.ss[0] = s0;
      st.ss[1] = s1;
      st.cs = COM_SEQ[ci];
    }
  }
  out.is = is_;
  __sync_synchronize();                              // complete the buffer before the flip
  front_ = (uint8_t)(front_ ^ 1);
}

void blankNow() {
  std::memset(on_, 0, sizeof on_);
  render();
}

// Pins low and the panel blanked before the scan starts, so nothing random is latched at boot.
void begin() {
  for (int p : { PIN_CLK, PIN_DATA, PIN_CLK_1, PIN_DATA_1 }) {
    pinMode(p, OUTPUT);
    digitalWrite(p, LOW);
  }
  delayMicroseconds(250);                            // AiP33628 ignores the first 200 us after POR
  std::memset(on_, 0, sizeof on_);
  std::memset(level_, 0, sizeof level_);
  std::memset(buf_, 0, sizeof buf_);
  render();
  sendPair(0, 0, 0, 0);                              // blank both latches immediately

  gptimer_config_t tcfg = {};
  tcfg.clk_src = GPTIMER_CLK_SRC_DEFAULT;
  tcfg.direction = GPTIMER_COUNT_UP;
  tcfg.resolution_hz = 1000000;                      // 1 tick per microsecond

  gptimer_alarm_config_t acfg = {};
  acfg.alarm_count = UNIT_US;

  gptimer_event_callbacks_t cbs = {};
  cbs.on_alarm = scanTick;

  timerOk_ = gptimer_new_timer(&tcfg, &timer_) == ESP_OK &&
             gptimer_register_event_callbacks(timer_, &cbs, nullptr) == ESP_OK &&
             gptimer_set_alarm_action(timer_, &acfg) == ESP_OK &&
             gptimer_enable(timer_) == ESP_OK &&
             gptimer_start(timer_) == ESP_OK;
  if (!timerOk_) Serial.println("ERROR: display scan timer could not be started");
}

bool timerOk() { return timerOk_; }

// The scan interrupt is not cache-safe in this core build, so it is masked while flash is being
// written and whichever COM pair was last latched would stay lit at four times its duty. Blank
// the drivers and stop the scan around every flash write instead: a few milliseconds dark.
// Calls nest; only the outermost pair stops and restarts the scan.
void pauseForFlash() {
  if (pauseDepth_++ > 0) return;
  if (timerOk_) gptimer_stop(timer_);
  sendPair(0, 0, 0, 0);
}

void resumeAfterFlash() {
  if (pauseDepth_ == 0) return;
  if (--pauseDepth_ > 0) return;
  step_ = 0;
  if (timerOk_) {
    uint64_t now = 0;
    gptimer_get_raw_count(timer_, &now);
    gptimer_alarm_config_t a = {};
    a.alarm_count = now + UNIT_US;
    gptimer_set_alarm_action(timer_, &a);
    gptimer_start(timer_);
  }
}

uint32_t isrCount() { return isrCount_; }
uint32_t earlyCount() { return earlyCount_; }
uint32_t lateCount() { return lateCount_; }
uint8_t steps() { return buf_[front_].n; }       // scan steps per 2400 us cycle in the live schedule

}  // namespace panel

